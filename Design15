<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- Smooth scroll (Lenis) with graceful fallback ---- */
  var lenis=null, scrollY=function(){return window.pageYOffset||document.documentElement.scrollTop;};
  if(!reduce && window.Lenis){
    lenis = new Lenis({lerp:0.09, wheelMultiplier:1, smoothWheel:true});
    function raf(t){lenis.raf(t);requestAnimationFrame(raf);}
    requestAnimationFrame(raf);
  }

  /* ---- Hero C-reveal scrub ---- */
  var heroScroll=document.querySelector('.hero-scroll');
  var revealG=document.getElementById('revealG');
  var revealSvg=document.getElementById('revealSvg');
  var heroImg=document.getElementById('heroImg');
  var heroHeadline=document.getElementById('heroHeadline');
  var vh=window.innerHeight;

  function clamp(v,a,b){return Math.max(a,Math.min(b,v));}
  function ease(t){return 1-Math.pow(1-t,3);} // easeOutCubic

  function updateHero(){
    var total = heroScroll.offsetHeight - vh;
    var p = clamp(scrollY()/total,0,1);           // 0..1 through the hero
    // Phase 1: zoom the C to reveal (0 -> .74)
    var pz = clamp(p/0.74,0,1);
    var k = 0.58 + ease(pz)*14.6;                  // scale factor, grows toward viewer
    revealG.style.transform='scale('+k.toFixed(3)+')';
    // fade tint fully out in last stretch of zoom so edges go clean
    var op = 1 - clamp((pz-0.8)/0.2,0,1);
    revealSvg.style.opacity=op.toFixed(3);
    // hero image push-in
    var imgScale = 1.18 - 0.18*ease(clamp(p/0.9,0,1));
    heroImg.style.transform='scale('+imgScale.toFixed(3)+')';
    // headline fade up after reveal (.6 -> .95)
    var ph = clamp((p-0.6)/0.34,0,1);
    heroHeadline.style.opacity=ph.toFixed(3);
    heroHeadline.style.transform='translateY('+((1-ease(ph))*30).toFixed(1)+'px)';
  }

  /* ---- Nav solid toggle + progress ---- */
  var nav=document.getElementById('nav');
  var progress=document.getElementById('progress');
  function updateChrome(){
    var y=scrollY();
    var switchAt = heroScroll.offsetHeight - vh*0.35;
    nav.classList.toggle('solid', y>switchAt);
    var docH=document.documentElement.scrollHeight-vh;
    progress.style.width=(clamp(y/docH,0,1)*100)+'%';
  }

  function onScroll(){updateHero();updateChrome();}
  if(lenis){lenis.on('scroll',function(e){scrollY=function(){return e.scroll;};onScroll();});}
  window.addEventListener('scroll',onScroll,{passive:true});
  window.addEventListener('resize',function(){vh=window.innerHeight;onScroll();});
  onScroll();

  /* ---- Reveal on view (IntersectionObserver) ---- */
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);}
    });
  },{threshold:0.16,rootMargin:'0px 0px -8% 0px'});
  document.querySelectorAll('.reveal,.lines').forEach(function(el){io.observe(el);});

  /* ---- Count-up stats ---- */
  var cio=new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(!en.isIntersecting)return;
      var el=en.target, to=parseFloat(el.dataset.to), dec=el.dataset.dec;
      var start=null, dur=1500;
      function step(ts){
        if(!start)start=ts;
        var pr=clamp((ts-start)/dur,0,1), val=ease(pr)*to;
        if(dec!==undefined){el.textContent=(ease(pr)*(to+parseFloat('0.'+dec))).toFixed(1).replace('.',',');}
        else{el.textContent=Math.round(val);}
        if(pr<1)requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
      cio.unobserve(el);
    });
  },{threshold:0.5});
  document.querySelectorAll('.count').forEach(function(el){cio.observe(el);});

  /* ---- Anchor smooth links ---- */
  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click',function(e){
      var id=a.getAttribute('href');
      if(id.length<2)return;
      var t=document.querySelector(id);
      if(!t)return;
      e.preventDefault();
      closeMobile();
      if(lenis){lenis.scrollTo(t,{offset:-10,duration:1.3});}
      else{t.scrollIntoView({behavior:reduce?'auto':'smooth'});}
    });
  });

  /* ---- FAB ---- */
  var fab=document.getElementById('fab');
  document.getElementById('fabBtn').addEventListener('click',function(){fab.classList.toggle('open');});
  document.addEventListener('click',function(e){if(!fab.contains(e.target))fab.classList.remove('open');});

  /* ---- Mobile menu ---- */
  var mm=document.getElementById('mobileMenu');
  function closeMobile(){mm.classList.remove('open');}
  document.getElementById('burger').addEventListener('click',function(){mm.classList.add('open');});
  document.getElementById('mmClose').addEventListener('click',closeMobile);

})();
</script>
