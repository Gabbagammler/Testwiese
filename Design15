<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CUBION Immobilien AG · Gewerbeimmobilien im Revier</title>
<meta name="description" content="CUBION ist Ihr Partner für Gewerbeimmobilien im Ruhrgebiet. Büro-, Industrie- und Investmentflächen, datenbasiert vermittelt und ehrlich beraten.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
@font-face{
  font-family:'Benton Sans Wide';
  font-weight:900;
  font-style:normal;
  font-display:block;
  src:url(data:font/otf;base64,) format('opentype');
}

:root{
  --charcoal:#1B1714;
  --bone:#F4F3F0;
  --orange:#ff6f20;
  --ink:#1B1714;
  --muted:#7A736C;
  --muted-2:#A8A29B;
  --line:#E2DFD9;
  --line-dark:rgba(244,243,240,.16);
  --bone-2:#ECEAE4;
  --display:'Benton Sans Wide',Impact,sans-serif;
  --body:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --ease:cubic-bezier(.22,.61,.36,1);
  --ease-out:cubic-bezier(.16,1,.3,1);
  --pad:clamp(20px,5vw,90px);
}

*{margin:0;padding:0;box-sizing:border-box}
html{-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{
  font-family:var(--body);
  background:var(--bone);
  color:var(--ink);
  font-size:17px;
  line-height:1.6;
  font-weight:400;
  overflow-x:hidden;
}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
::selection{background:var(--orange);color:#fff}

.wrap{max-width:1440px;margin:0 auto;padding-left:var(--pad);padding-right:var(--pad)}

/* ===== display type helpers ===== */
.display{
  font-family:var(--display);
  text-transform:uppercase;
  line-height:.92;
  letter-spacing:-.005em;
  font-weight:900;
}
.eyebrow{
  font-size:12px;
  letter-spacing:.28em;
  text-transform:uppercase;
  font-weight:500;
  color:var(--muted);
}
.eyebrow .dot{color:var(--orange)}

/* ============ NAV ============ */
header.nav{
  position:fixed;top:0;left:0;right:0;z-index:120;
  padding:22px var(--pad);
  display:flex;align-items:center;justify-content:space-between;
  transition:background .5s var(--ease),padding .5s var(--ease),color .5s var(--ease),box-shadow .5s var(--ease);
  color:#fff;
  mix-blend-mode:normal;
}
header.nav.solid{
  background:rgba(244,243,240,.88);
  backdrop-filter:blur(14px) saturate(1.2);
  -webkit-backdrop-filter:blur(14px) saturate(1.2);
  color:var(--ink);
  padding-top:16px;padding-bottom:16px;
  box-shadow:0 1px 0 var(--line);
}
.brand{
  font-family:var(--display);
  font-weight:900;
  text-transform:uppercase;
  font-size:20px;
  letter-spacing:.02em;
  line-height:1;
}
.brand .o{color:var(--orange)}
.nav-menu{display:flex;gap:34px;align-items:center}
.nav-menu a{
  font-size:13px;letter-spacing:.04em;font-weight:500;position:relative;
  opacity:.85;transition:opacity .3s var(--ease);
}
.nav-menu a::after{
  content:"";position:absolute;left:0;bottom:-6px;height:1.5px;width:0;background:var(--orange);
  transition:width .4s var(--ease);
}
.nav-menu a:hover{opacity:1}
.nav-menu a:hover::after{width:100%}
.nav-cta{
  display:inline-flex;align-items:center;gap:9px;
  font-size:13px;font-weight:600;letter-spacing:.02em;
  padding:11px 20px;border-radius:100px;
  border:1.5px solid currentColor;
  transition:background .35s var(--ease),color .35s var(--ease),border-color .35s var(--ease);
}
.nav-cta:hover{background:var(--orange);border-color:var(--orange);color:#fff}
.nav-right{display:flex;align-items:center;gap:26px}
.burger{display:none;flex-direction:column;gap:5px;background:none;border:0;cursor:pointer;padding:8px;color:inherit}
.burger span{display:block;width:26px;height:2px;background:currentColor;transition:.35s var(--ease)}

/* ============ HERO / C-REVEAL ============ */
.hero-scroll{position:relative;height:300vh;background:var(--charcoal)}
.hero{
  position:sticky;top:0;height:100vh;width:100%;overflow:hidden;background:var(--charcoal);
}
.hero-img{
  position:absolute;inset:0;
  background-image:url(data:image/jpeg;base64,);
  background-size:cover;background-position:center 42%;
  transform:scale(1.18);
  will-change:transform;
}
.hero-grade{
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(15,12,10,.55) 0%,rgba(15,12,10,.15) 32%,rgba(15,12,10,.12) 60%,rgba(15,12,10,.72) 100%);
  z-index:2;pointer-events:none;
}
/* SVG mask that punches the C */
.reveal-svg{
  position:absolute;inset:0;width:100%;height:100%;z-index:5;
  will-change:transform,opacity;
}
.reveal-g{
  transform-box:view-box;
  transform-origin:512px 512px;
  will-change:transform;
}

.hero-ui{position:absolute;inset:0;z-index:8;pointer-events:none;color:#fff}
.hero-eyebrow{
  position:absolute;left:var(--pad);top:132px;
  color:rgba(255,255,255,.86);
}
.hero-scrollhint{
  position:absolute;left:50%;bottom:36px;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:12px;
  font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:rgba(255,255,255,.8);
}
.hero-scrollhint .bar{width:1px;height:44px;background:linear-gradient(rgba(255,255,255,.9),rgba(255,255,255,0));position:relative;overflow:hidden}
.hero-scrollhint .bar::after{content:"";position:absolute;top:-40%;left:0;width:100%;height:40%;background:var(--orange);animation:trickle 2.1s var(--ease) infinite}
@keyframes trickle{0%{top:-40%}60%,100%{top:120%}}

.hero-headline{
  position:absolute;left:var(--pad);right:var(--pad);bottom:12vh;
  opacity:0;transform:translateY(28px);
  will-change:opacity,transform;
}
.hero-headline h1{
  font-family:var(--display);text-transform:uppercase;font-weight:900;
  color:#fff;line-height:.9;letter-spacing:-.01em;
  font-size:clamp(42px,8.4vw,150px);
  text-shadow:0 4px 40px rgba(0,0,0,.35);
}
.hero-headline h1 .rev{color:var(--orange)}
.hero-headline .sub{
  margin-top:22px;max-width:520px;font-size:16px;color:rgba(255,255,255,.9);font-weight:400;
  display:flex;gap:10px;flex-wrap:wrap;
}
.hero-headline .sub span{padding:7px 15px;border:1px solid rgba(255,255,255,.35);border-radius:100px;font-size:13px;letter-spacing:.02em}

/* ============ SECTION SCAFFOLD ============ */
section{position:relative}
.sec{padding:clamp(72px,13vh,190px) 0}
.sec-label{
  font-size:12px;letter-spacing:.28em;text-transform:uppercase;font-weight:500;color:var(--orange);
  display:flex;align-items:center;gap:14px;margin-bottom:34px;
}
.sec-label::before{content:"";width:34px;height:1.5px;background:var(--orange)}

/* reveal utility */
.reveal{opacity:0;transform:translateY(34px);transition:opacity 1s var(--ease-out),transform 1.1s var(--ease-out)}
.reveal.in{opacity:1;transform:none}
[data-delay="1"]{transition-delay:.09s}
[data-delay="2"]{transition-delay:.18s}
[data-delay="3"]{transition-delay:.27s}
[data-delay="4"]{transition-delay:.36s}

/* line-mask reveal for big headings */
.lines .line{display:block;overflow:hidden}
.lines .line > span{display:block;transform:translateY(105%);transition:transform 1.05s var(--ease-out)}
.lines.in .line > span{transform:none}
.lines.in .line:nth-child(2) > span{transition-delay:.1s}
.lines.in .line:nth-child(3) > span{transition-delay:.2s}

/* ============ INTRO ============ */
.intro{background:var(--bone)}
.intro .grid{display:grid;grid-template-columns:1fr;gap:min(6vw,90px)}
.intro-lead{
  font-family:var(--display);text-transform:uppercase;font-weight:900;
  font-size:clamp(30px,4.6vw,74px);line-height:.98;letter-spacing:-.01em;
  max-width:15ch;
}
.intro-lead .hl{color:var(--orange)}
.intro-body{max-width:560px;margin-left:auto;color:var(--muted);font-size:18px;line-height:1.72}
.intro-body strong{color:var(--ink);font-weight:600}
.intro-body .btn-line{margin-top:34px}
@media(min-width:900px){
  .intro .grid{grid-template-columns:1.05fr .95fr;align-items:end}
}

/* buttons */
.btn{
  display:inline-flex;align-items:center;gap:12px;
  font-size:14px;font-weight:600;letter-spacing:.02em;
  padding:16px 28px;border-radius:100px;
  background:var(--charcoal);color:var(--bone);
  transition:transform .4s var(--ease),background .4s var(--ease),color .4s var(--ease),gap .4s var(--ease);
}
.btn:hover{background:var(--orange);color:#fff;gap:18px}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
.btn.ghost:hover{background:var(--ink);color:var(--bone);border-color:var(--ink)}
.btn.light{background:var(--bone);color:var(--charcoal)}
.btn.light:hover{background:var(--orange);color:#fff}
.arrow{transition:transform .4s var(--ease)}
.btn:hover .arrow{transform:translateX(4px)}

/* ============ STATS ============ */
.stats{background:var(--charcoal);color:var(--bone)}
.stats .row{display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:1px solid var(--line-dark)}
.stat{padding:44px 30px 40px 0;border-bottom:1px solid var(--line-dark)}
.stat .num{
  font-family:var(--display);font-weight:900;
  font-size:clamp(48px,7vw,104px);line-height:.9;letter-spacing:-.02em;
  display:flex;align-items:flex-start;gap:2px;
}
.stat .num .sfx{font-size:.42em;color:var(--orange);margin-top:.15em;font-weight:900}
.stat .lbl{margin-top:14px;color:var(--muted-2);font-size:14.5px;max-width:24ch;line-height:1.45}
@media(min-width:760px){.stats .row{grid-template-columns:repeat(5,1fr)}.stat{padding-right:22px}}
@media(min-width:760px){.stat + .stat{border-left:1px solid var(--line-dark);padding-left:26px}}

/* ============ LEISTUNGEN (asset cards) ============ */
.leist{background:var(--bone)}
.leist-head{display:grid;grid-template-columns:1fr;gap:26px;margin-bottom:60px}
.leist-head h2{font-family:var(--display);text-transform:uppercase;font-weight:900;font-size:clamp(30px,4.4vw,66px);line-height:.98;letter-spacing:-.01em;max-width:16ch}
@media(min-width:900px){.leist-head{grid-template-columns:auto 1fr;align-items:end}.leist-head .lead-note{max-width:360px;color:var(--muted);padding-bottom:8px}}
.cards{display:grid;grid-template-columns:1fr;gap:2px;background:var(--line);border:1px solid var(--line)}
@media(min-width:700px){.cards{grid-template-columns:1fr 1fr}}
@media(min-width:1080px){.cards{grid-template-columns:repeat(4,1fr)}}
.card{
  background:var(--bone);padding:38px 32px 34px;position:relative;overflow:hidden;
  min-height:340px;display:flex;flex-direction:column;justify-content:space-between;
  transition:background .5s var(--ease),color .5s var(--ease);
}
.card .idx{font-family:var(--display);font-weight:900;font-size:15px;color:var(--muted-2);letter-spacing:.04em}
.card h3{font-family:var(--display);text-transform:uppercase;font-weight:900;font-size:clamp(22px,2vw,29px);line-height:.98;margin:52px 0 14px;letter-spacing:-.01em}
.card p{color:var(--muted);font-size:15px;line-height:1.55;transition:color .5s var(--ease)}
.card .go{margin-top:26px;display:inline-flex;align-items:center;gap:10px;font-size:13px;font-weight:600;letter-spacing:.03em;color:var(--orange);transition:color .5s var(--ease),gap .4s var(--ease)}
.card::before{content:"";position:absolute;inset:0;background:var(--charcoal);transform:translateY(101%);transition:transform .6s var(--ease);z-index:0}
.card > *{position:relative;z-index:1}
.card:hover{color:var(--bone)}
.card:hover::before{transform:translateY(0)}
.card:hover .idx{color:rgba(244,243,240,.5)}
.card:hover p{color:rgba(244,243,240,.75)}
.card:hover .go{color:#fff;gap:16px}

/* ============ MARKETS ============ */
.markets{background:var(--charcoal);color:var(--bone)}
.markets .m-head h2{font-family:var(--display);text-transform:uppercase;font-weight:900;font-size:clamp(30px,4.6vw,72px);line-height:.96;letter-spacing:-.01em;max-width:14ch}
.markets .m-head p{color:var(--muted-2);max-width:46ch;margin-top:22px}
.m-list{margin-top:58px;border-top:1px solid var(--line-dark)}
.m-item{
  display:grid;grid-template-columns:1fr;gap:0;align-items:center;
  border-bottom:1px solid var(--line-dark);padding:30px 0;
  position:relative;transition:padding .5s var(--ease);
}
.m-item .m-city{font-family:var(--display);text-transform:uppercase;font-weight:900;font-size:clamp(34px,6vw,88px);line-height:.9;letter-spacing:-.02em;transition:transform .6s var(--ease),color .5s var(--ease)}
.m-item .m-txt{color:var(--muted-2);max-width:52ch;font-size:15.5px;line-height:1.6}
.m-item .m-more{margin-top:16px;display:inline-flex;gap:9px;align-items:center;color:var(--orange);font-size:13px;font-weight:600;letter-spacing:.03em}
.m-thumb{
  position:absolute;right:2vw;top:50%;transform:translateY(-50%) scale(.92);
  width:min(30vw,380px);aspect-ratio:16/10;object-fit:cover;border-radius:4px;
  opacity:0;pointer-events:none;transition:opacity .5s var(--ease),transform .6s var(--ease);z-index:3;
  box-shadow:0 30px 70px rgba(0,0,0,.5);
}
@media(min-width:920px){
  .m-item{grid-template-columns:minmax(0,5fr) minmax(0,4fr);gap:40px}
  .m-item:hover{padding-left:22px}
  .m-item:hover .m-city{color:var(--orange)}
  .m-item:hover .m-thumb{opacity:1;transform:translateY(-50%) scale(1)}
}

/* ============ DEALS ============ */
.deals{background:var(--bone)}
.deal-list{border-top:1px solid var(--line)}
.deal{
  display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:baseline;
  padding:28px 0;border-bottom:1px solid var(--line);
  transition:background .4s var(--ease),padding .45s var(--ease);
}
.deal .yr{font-family:var(--display);font-weight:900;font-size:15px;color:var(--muted-2)}
.deal .d-main{display:flex;flex-direction:column;gap:6px}
.deal .d-city{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--orange);font-weight:600}
.deal .d-ttl{font-size:clamp(19px,2.1vw,27px);font-weight:500;line-height:1.25;letter-spacing:-.01em}
.deal .d-arw{font-size:22px;color:var(--muted-2);transition:transform .4s var(--ease),color .4s var(--ease)}
.deal:hover{padding-left:16px;padding-right:16px}
.deal:hover .d-arw{color:var(--orange);transform:translate(4px,-4px)}

/* ============ QUOTE ============ */
.quote{background:var(--charcoal);color:var(--bone);text-align:left}
.quote .mark{font-family:var(--display);color:var(--orange);font-size:120px;line-height:.5;height:60px;display:block}
.quote blockquote{
  font-family:var(--display);text-transform:uppercase;font-weight:900;
  font-size:clamp(26px,3.9vw,60px);line-height:1.02;letter-spacing:-.01em;max-width:20ch;margin:24px 0 40px;
}
.quote blockquote .hl{color:var(--orange)}
.quote cite{font-style:normal;color:var(--muted-2);font-size:14px;letter-spacing:.02em}
.quote cite strong{color:var(--bone);display:block;font-family:var(--display);text-transform:uppercase;font-size:16px;letter-spacing:.03em;margin-bottom:6px;font-weight:900}

/* marquee */
.marquee{overflow:hidden;border-top:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark);padding:22px 0;background:var(--charcoal)}
.marquee-track{display:flex;gap:40px;white-space:nowrap;width:max-content;animation:march 26s linear infinite}
.marquee-track span{font-family:var(--display);text-transform:uppercase;font-weight:900;font-size:clamp(22px,2.8vw,44px);color:rgba(244,243,240,.18);letter-spacing:.01em;display:inline-flex;align-items:center;gap:40px}
.marquee-track span::after{content:"◆";color:var(--orange);font-size:.4em}
@keyframes march{to{transform:translateX(-50%)}}

/* ============ CTA ============ */
.cta{background:var(--orange);color:#fff;position:relative;overflow:hidden}
.cta .wrap{position:relative;z-index:2}
.cta h2{font-family:var(--display);text-transform:uppercase;font-weight:900;font-size:clamp(46px,11vw,180px);line-height:.86;letter-spacing:-.02em}
.cta p{max-width:44ch;margin:26px 0 40px;font-size:19px;line-height:1.6;color:rgba(255,255,255,.94)}
.cta .btns{display:flex;gap:16px;flex-wrap:wrap}
.cta .btn{background:#fff;color:var(--charcoal)}
.cta .btn:hover{background:var(--charcoal);color:#fff}
.cta .btn.ghost{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.7)}
.cta .btn.ghost:hover{background:#fff;color:var(--orange);border-color:#fff}

/* ============ FOOTER ============ */
footer.ft{background:var(--charcoal);color:var(--bone);padding:clamp(60px,9vh,120px) 0 40px}
.ft-top{display:grid;grid-template-columns:1fr;gap:48px;padding-bottom:64px;border-bottom:1px solid var(--line-dark)}
@media(min-width:820px){.ft-top{grid-template-columns:1.4fr 1fr 1fr 1fr}}
.ft-brand{font-family:var(--display);text-transform:uppercase;font-weight:900;font-size:44px;line-height:1;letter-spacing:.01em}
.ft-brand .o{color:var(--orange)}
.ft-brand p{font-family:var(--body);text-transform:none;font-weight:400;font-size:15px;line-height:1.7;color:var(--muted-2);margin-top:22px;letter-spacing:0}
.ft-col h4{font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:var(--muted-2);margin-bottom:20px;font-weight:600}
.ft-col a,.ft-col span{display:block;font-size:15px;color:rgba(244,243,240,.82);margin-bottom:12px;transition:color .3s var(--ease)}
.ft-col a:hover{color:var(--orange)}
.ft-bottom{display:flex;flex-wrap:wrap;gap:20px 40px;justify-content:space-between;align-items:center;padding-top:34px;color:var(--muted-2);font-size:13px}
.ft-bottom .badges{display:flex;gap:26px;align-items:center;font-family:var(--display);text-transform:uppercase;font-weight:900;font-size:13px;letter-spacing:.06em;color:rgba(244,243,240,.55)}
.ft-legal{display:flex;gap:22px}

/* ============ FAB (Selina) ============ */
.fab{position:fixed;right:24px;bottom:24px;z-index:130;font-family:var(--body)}
.fab-panel{
  position:absolute;right:0;bottom:78px;width:300px;background:var(--bone);color:var(--ink);
  border-radius:16px;padding:22px;box-shadow:0 24px 60px rgba(0,0,0,.28);
  opacity:0;transform:translateY(14px) scale(.96);pointer-events:none;
  transition:opacity .4s var(--ease),transform .4s var(--ease);transform-origin:bottom right;
  border:1px solid var(--line);
}
.fab.open .fab-panel{opacity:1;transform:none;pointer-events:auto}
.fab-panel .who{display:flex;align-items:center;gap:14px;margin-bottom:16px}
.fab-panel .ava{width:52px;height:52px;border-radius:50%;background:var(--orange);color:#fff;display:grid;place-items:center;font-family:var(--display);font-weight:900;font-size:19px}
.fab-panel .who b{display:block;font-family:var(--display);text-transform:uppercase;font-size:15px;letter-spacing:.02em}
.fab-panel .who small{color:var(--muted);font-size:13px}
.fab-panel a{display:flex;align-items:center;gap:11px;padding:11px 0;font-size:14.5px;border-top:1px solid var(--line)}
.fab-panel a .ic{color:var(--orange)}
.fab-btn{
  width:60px;height:60px;border-radius:50%;background:var(--charcoal);color:#fff;border:0;cursor:pointer;
  display:grid;place-items:center;box-shadow:0 12px 34px rgba(27,23,20,.4);
  transition:transform .4s var(--ease),background .4s var(--ease);position:relative;
}
.fab-btn:hover{transform:scale(1.06);background:var(--orange)}
.fab-btn .pulse{position:absolute;top:2px;right:2px;width:12px;height:12px;background:var(--orange);border:2px solid var(--charcoal);border-radius:50%}
.fab.open .fab-btn{background:var(--orange)}
.fab-btn svg{transition:transform .4s var(--ease)}
.fab.open .fab-btn svg{transform:rotate(90deg)}

/* progress bar */
.progress{position:fixed;left:0;top:0;height:2px;background:var(--orange);z-index:140;width:0}

/* ============ RESPONSIVE NAV ============ */
@media(max-width:940px){
  .nav-menu,.nav-cta{display:none}
  .burger{display:flex}
  .mobile-menu{position:fixed;inset:0;background:var(--charcoal);z-index:125;display:flex;flex-direction:column;justify-content:center;padding:var(--pad);transform:translateX(100%);transition:transform .55s var(--ease);color:var(--bone)}
  .mobile-menu.open{transform:none}
  .mobile-menu a{font-family:var(--display);text-transform:uppercase;font-weight:900;font-size:34px;padding:14px 0;border-bottom:1px solid var(--line-dark);display:flex;justify-content:space-between;align-items:baseline}
  .mobile-menu a .n{font-size:13px;color:var(--orange)}
