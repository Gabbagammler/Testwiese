<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Objektsuche – CUBION Immobilien AG</title>
<meta name="description" content="Büro-, Praxis-, Hallen- und Logistikflächen im Ruhrgebiet. Finden Sie mit CUBION die passende Gewerbeimmobilie.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#14110F;--charcoal:#1B1714;--steel:#2A2522;--paper:#FFFFFF;--bone:#F4F3F0;
  --line:#E4E2DD;--orange:#F05A28;--orange-2:#FF6B35;--concrete:#9A938C;--steel-gray:#5E5852;
  --muted:#8A837C;--muted-light:rgba(255,255,255,.62);
  --maxw:1320px;--gut:clamp(18px,4vw,56px);--ease:cubic-bezier(.16,1,.3,1);
  --fs-h2:clamp(2rem,5vw,4rem);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bone);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
body.lock{overflow:hidden}
img,svg{display:block;max-width:100%}a{color:inherit;text-decoration:none}
::selection{background:var(--orange);color:#fff}
.wrap{max-width:var(--maxw);margin:0 auto;padding-inline:var(--gut)}
.display{font-family:'Anton',sans-serif;font-weight:400;text-transform:uppercase;line-height:.9;letter-spacing:.01em}
.eyebrow{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.28em;display:inline-flex;align-items:center;gap:.7em;color:var(--orange)}
.eyebrow::before{content:"";width:34px;height:2px;background:var(--orange);display:inline-block}

/* NAV */
header.nav{position:fixed;inset:0 0 auto 0;z-index:80;display:flex;align-items:center;justify-content:space-between;padding:16px var(--gut);background:rgba(20,17,15,.92);backdrop-filter:blur(14px)}
.brand{font-family:'Anton',sans-serif;text-transform:uppercase;font-size:1.5rem;letter-spacing:.02em;color:#fff;display:flex;align-items:center;gap:.5ch}
.brand .dot{width:.42em;height:.42em;background:var(--orange);display:inline-block;margin-bottom:.18em;transform:skewX(-12deg)}
.nav-links{display:flex;gap:28px;align-items:center}
.nav-links a{color:rgba(255,255,255,.82);font-size:.86rem;font-weight:500;position:relative;padding:6px 0;transition:color .25s}
.nav-links a:hover{color:#fff}
.nav-right{display:flex;align-items:center;gap:16px}
.merk{display:inline-flex;align-items:center;gap:8px;color:#fff;font-size:.84rem;font-weight:600;border:1px solid rgba(255,255,255,.25);padding:9px 14px;border-radius:100px;transition:.25s var(--ease)}
.merk:hover{border-color:var(--orange)}
.merk svg{width:16px;height:16px;fill:var(--orange)}
.merk .ct{background:var(--orange);color:#fff;border-radius:100px;min-width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;padding:0 6px}
.burger{display:none;flex-direction:column;gap:5px;background:none;border:0;cursor:pointer;padding:6px}
.burger span{width:24px;height:2px;background:#fff}
@media(max-width:920px){.nav-links{display:none}.burger{display:flex}}

/* HERO */
.hero{background:var(--ink);color:#fff;padding:120px var(--gut) 46px;position:relative;overflow:hidden}
.hero-grid{position:absolute;inset:-30% -10% auto -10%;height:120%;z-index:0;opacity:.4;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:60px 60px;transform:perspective(800px) rotateX(60deg) scale(2);transform-origin:top center;-webkit-mask-image:linear-gradient(to bottom,#000,transparent);mask-image:linear-gradient(to bottom,#000,transparent)}
.hero-inner{position:relative;z-index:1;max-width:var(--maxw);margin:0 auto}
.hero h1{font-size:clamp(2.6rem,8vw,6rem);margin:14px 0 14px}
.hero p{color:var(--muted-light);max-width:54ch}
.hero .quicksearch{margin-top:30px;display:flex;gap:10px;max-width:560px}
.hero .quicksearch input{flex:1;border:0;border-radius:4px;padding:16px 18px;font-family:'Inter';font-size:1rem;font-weight:500}
.hero .quicksearch input:focus{outline:3px solid var(--orange)}

/* LAYOUT */
.layout{max-width:var(--maxw);margin:0 auto;padding:34px var(--gut) 70px;display:grid;grid-template-columns:300px 1fr;gap:30px;align-items:start}

/* SIDEBAR FILTERS */
.filters{position:sticky;top:84px;background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:24px}
.filters h2{font-family:'Anton';text-transform:uppercase;font-size:1.2rem;margin-bottom:6px}
.filters .reset{font-size:.78rem;font-weight:700;color:var(--orange);background:none;border:0;cursor:pointer;padding:0;margin-bottom:18px}
.fgroup{padding:16px 0;border-top:1px solid var(--line)}
.fgroup:first-of-type{border-top:0;padding-top:6px}
.flabel{font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;display:block}
.seg{display:flex;background:var(--bone);border-radius:5px;padding:4px;gap:4px}
.seg button{flex:1;border:0;background:none;cursor:pointer;font-family:'Inter';font-weight:600;font-size:.82rem;padding:9px 6px;border-radius:4px;color:var(--steel-gray);transition:.2s}
.seg button.active{background:var(--ink);color:#fff}
select,.numrow input{width:100%;border:1px solid var(--line);border-radius:5px;padding:11px 12px;font-family:'Inter';font-size:.9rem;font-weight:500;color:var(--ink);background:var(--paper)}
select:focus,.numrow input:focus{outline:2px solid var(--orange);border-color:var(--orange)}
.numrow{display:flex;gap:8px}
.rangeval{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-bottom:8px}
.rangeval b{color:var(--orange);font-weight:700}
input[type=range]{width:100%;-webkit-appearance:none;appearance:none;height:4px;border-radius:4px;background:var(--line);accent-color:var(--orange)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:var(--orange);cursor:pointer;border:3px solid var(--paper);box-shadow:0 0 0 1px var(--orange)}
input[type=range]::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:var(--orange);cursor:pointer;border:3px solid var(--paper)}

/* RESULTS */
.rhead{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:18px;flex-wrap:wrap}
.rcount{font-size:1rem}.rcount b{font-family:'Anton';font-size:1.5rem;color:var(--ink);vertical-align:-2px;margin-right:4px}
.rtools{display:flex;align-items:center;gap:10px}
.rtools select{width:auto;padding:9px 12px}
.viewtoggle{display:flex;border:1px solid var(--line);border-radius:5px;overflow:hidden;background:var(--paper)}
.viewtoggle button{border:0;background:none;cursor:pointer;padding:9px 11px;color:var(--muted);display:flex}
.viewtoggle button.active{background:var(--ink);color:#fff}
.viewtoggle svg{width:17px;height:17px}
.filter-open{display:none;align-items:center;gap:8px;border:1px solid var(--line);background:var(--paper);border-radius:5px;padding:9px 14px;font-weight:700;font-size:.84rem;cursor:pointer}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px}
.ocard{background:var(--paper);border:1px solid var(--line);border-radius:8px;overflow:hidden;display:flex;flex-direction:column;cursor:pointer;transition:transform .3s var(--ease),box-shadow .3s var(--ease);animation:pop .45s var(--ease) both}
@keyframes pop{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.ocard:hover{transform:translateY(-5px);box-shadow:0 22px 44px -26px rgba(0,0,0,.4)}
.ocard .ph{position:relative;aspect-ratio:16/10;overflow:hidden;background:var(--steel)}
.ocard .ph svg{width:100%;height:100%;transition:transform .6s var(--ease)}
.ocard:hover .ph svg{transform:scale(1.05)}
.ocard .badges{position:absolute;top:12px;left:12px;display:flex;gap:6px;flex-wrap:wrap}
.bdg{font-size:.64rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:5px 9px;border-radius:2px;color:#fff;background:var(--ink)}
.bdg.ex{background:var(--orange)}
.bdg.nb{background:#2d7d5a}
.heart{position:absolute;top:10px;right:10px;width:38px;height:38px;border-radius:50%;border:0;background:rgba(255,255,255,.92);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.2s var(--ease)}
.heart:hover{transform:scale(1.1)}
.heart svg{width:18px;height:18px;fill:none;stroke:var(--ink);stroke-width:2}
.heart.on svg{fill:var(--orange);stroke:var(--orange)}
.ocard .body{padding:18px 18px 20px;display:flex;flex-direction:column;gap:10px;flex:1}
.ocard .city{font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--steel-gray);display:flex;align-items:center;gap:7px}
.ocard .city .cd{width:9px;height:9px;transform:skewX(-12deg)}
.ocard h3{font-size:1.04rem;font-weight:700;line-height:1.32}
.ocard .facts{margin-top:auto;display:flex;gap:18px;padding-top:12px;border-top:1px solid var(--line)}
.ocard .facts div .k{font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.ocard .facts div .v{font-family:'Anton';font-size:1.25rem;line-height:1}
.ocard .facts div .v small{font-size:.5em;font-weight:400}
.ocard .det{font-size:.74rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--orange);display:inline-flex;gap:.5ch;align-self:flex-start}

/* LIST VIEW */
.grid.list{grid-template-columns:1fr}
.grid.list .ocard{flex-direction:row}
.grid.list .ocard .ph{aspect-ratio:auto;width:300px;flex:0 0 auto}
.grid.list .ocard .body{flex:1}
@media(max-width:680px){.grid.list .ocard{flex-direction:column}.grid.list .ocard .ph{width:100%;aspect-ratio:16/10}}

.empty{text-align:center;padding:70px 20px;color:var(--muted)}
.empty h3{font-family:'Anton';text-transform:uppercase;font-size:1.6rem;color:var(--ink);margin-bottom:10px}
.empty button{margin-top:18px;background:var(--orange);color:#fff;border:0;border-radius:4px;padding:13px 24px;font-weight:700;cursor:pointer}

/* DETAIL MODAL */
.modal{position:fixed;inset:0;z-index:120;display:none}
.modal.open{display:block}
.modal .backdrop{position:absolute;inset:0;background:rgba(10,8,7,.65);backdrop-filter:blur(4px);animation:fade .3s}
@keyframes fade{from{opacity:0}to{opacity:1}}
.sheet{position:absolute;top:0;right:0;height:100%;width:min(880px,100%);background:var(--paper);overflow-y:auto;box-shadow:-30px 0 80px -30px rgba(0,0,0,.6);animation:slideIn .45s var(--ease)}
@keyframes slideIn{from{transform:translateX(40px);opacity:.6}to{transform:none;opacity:1}}
.sheet-top{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;align-items:center;padding:14px 22px;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.sheet-nav{display:flex;gap:8px}
.iconbtn{width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:var(--paper);cursor:pointer;font-size:1.3rem;display:flex;align-items:center;justify-content:center;color:var(--ink);transition:.2s var(--ease)}
.iconbtn:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
.gallery{position:relative}
.gallery .main{aspect-ratio:16/9;background:var(--steel)}
.gallery .main svg{width:100%;height:100%}
.gallery .gbadges{position:absolute;top:16px;left:16px;display:flex;gap:6px}
.thumbs{display:flex;gap:8px;padding:10px 16px;background:var(--ink)}
.thumbs button{flex:1;border:2px solid transparent;border-radius:4px;overflow:hidden;cursor:pointer;background:none;padding:0;aspect-ratio:16/10}
.thumbs button.active{border-color:var(--orange)}
.thumbs svg{width:100%;height:100%}
.sheet-body{padding:26px 30px 60px}
.sheet-body .city{font-size:.74rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--steel-gray);display:flex;align-items:center;gap:8px}
.sheet-body .city .cd{width:10px;height:10px;transform:skewX(-12deg)}
.sheet-body h2{font-family:'Anton';text-transform:uppercase;font-size:clamp(1.6rem,3.5vw,2.6rem);line-height:1.02;margin:10px 0 6px}
.sheet-body .addr{color:var(--muted);font-size:.95rem}
.factgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:8px;overflow:hidden;margin:24px 0}
.factgrid .f{background:var(--paper);padding:18px 16px}
.factgrid .f .k{font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.factgrid .f .v{font-family:'Anton';font-size:1.5rem;line-height:1.1;margin-top:4px}
.factgrid .f .v small{font-size:.46em;font-weight:400}
@media(max-width:620px){.factgrid{grid-template-columns:repeat(2,1fr)}}
.sec-h{font-family:'Anton';text-transform:uppercase;font-size:1.1rem;margin:30px 0 14px}
.sheet-body p.desc{color:var(--steel-gray)}
.feats{display:flex;flex-wrap:wrap;gap:9px}
.feat{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);border-radius:100px;padding:9px 15px;font-size:.86rem;font-weight:500}
.feat svg{width:15px;height:15px;fill:var(--orange)}
.agent{display:flex;gap:18px;align-items:center;background:var(--bone);border-radius:8px;padding:20px;margin-top:14px}
.agent img{width:74px;height:74px;border-radius:6px;object-fit:cover;flex:0 0 auto}
.agent .an{font-family:'Anton';text-transform:uppercase;font-size:1.1rem}
.agent .ar{color:var(--orange);font-weight:600;font-size:.84rem;margin-bottom:6px}
.agent .ac{font-size:.86rem;color:var(--steel-gray)}.agent .ac a:hover{color:var(--orange)}
.sheet-cta{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}
.sheet-cta a,.sheet-cta button{flex:1;min-width:180px;text-align:center;border:0;cursor:pointer;font-family:'Anton';text-transform:uppercase;letter-spacing:.03em;font-size:1rem;padding:16px;border-radius:4px;transition:.25s var(--ease)}
.sheet-cta .primary{background:var(--orange);color:#fff}.sheet-cta .primary:hover{background:var(--orange-2)}
.sheet-cta .sec{background:none;border:1px solid var(--line);color:var(--ink)}.sheet-cta .sec:hover{border-color:var(--ink)}
.maplink{margin-top:14px;display:inline-flex;align-items:center;gap:.5ch;font-size:.86rem;font-weight:700;color:var(--orange)}
.disclaimer{margin-top:30px;font-size:.74rem;color:var(--muted);border-top:1px solid var(--line);padding-top:16px}

/* FILTER DRAWER (mobile) */
@media(max-width:900px){
  .layout{grid-template-columns:1fr}
  .filters{position:fixed;inset:0;z-index:90;border-radius:0;overflow-y:auto;transform:translateX(-100%);transition:transform .4s var(--ease)}
  .filters.open{transform:none}
  .filter-open{display:inline-flex}
  .filters .closef{display:block;width:100%;margin-top:18px;background:var(--ink);color:#fff;border:0;border-radius:4px;padding:14px;font-weight:700;cursor:pointer}
}
@media(min-width:901px){.filters .closef{display:none}}

/* FOOTER */
footer{background:var(--ink);color:#fff;padding:60px 0 36px}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.1fr;gap:36px;padding-bottom:50px;border-bottom:1px solid rgba(255,255,255,.12)}
.foot-brand .brand{font-size:2rem;margin-bottom:16px}
.foot-brand address{font-style:normal;color:var(--muted-light);font-size:.9rem;line-height:1.9}
.foot-brand address a:hover{color:var(--orange)}
.foot-col h4{font-size:.72rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--orange);margin-bottom:16px}
.foot-col a{display:block;color:var(--muted-light);font-size:.9rem;padding:5px 0}
.foot-col a:hover{color:#fff}
.foot-bottom{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;padding-top:26px;font-size:.8rem;color:var(--muted)}
@media(max-width:760px){.foot-grid{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.foot-grid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*{animation-duration:.001ms!important;transition-duration:.001ms!important}}
</style>
</head>
<body>

<!-- NAV -->
<header class="nav">
  <a href="index.html" class="brand">Cubion<span class="dot"></span></a>
  <nav class="nav-links">
    <a href="index.html">Start</a>
    <a href="buerovermietung.html">Märkte</a>
    <a href="vermietung.html">Leistungen</a>
    <a href="referenzen.html">Referenzen</a>
    <a href="team.html">Team</a>
  </nav>
  <div class="nav-right">
    <button class="merk" id="merkBtn" title="Merkliste">
      <svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.7-10-9.3C.4 8.4 2 5 5.3 5c2 0 3.4 1.1 4.2 2.4C10.3 6.1 11.7 5 13.7 5 17 5 18.6 8.4 17 11.7 14.5 16.3 12 21 12 21z"/></svg>
      Merkliste <span class="ct" id="merkCt">0</span>
    </button>
    <button class="burger" onclick="location.href='index.html'" aria-label="Menü"><span></span><span></span><span></span></button>
  </div>
</header>

<!-- HERO -->
<section class="hero">
  <div class="hero-grid"></div>
  <div class="hero-inner">
    <span class="eyebrow">Objektsuche</span>
    <h1 class="display">Ihre Fläche<br>im Ruhrgebiet</h1>
    <p>Büro-, Praxis-, Hallen- und Logistikflächen aus erster Hand. Filtern Sie nach Stadt, Größe und Mietpreis und fordern Sie das Exposé direkt an.</p>
    <div class="quicksearch">
      <input type="search" id="q" placeholder="Suche nach Lage, Objekt oder Straße …" aria-label="Suche">
    </div>
  </div>
</section>

<!-- LAYOUT -->
<div class="layout">
  <!-- FILTERS -->
  <aside class="filters" id="filters">
    <h2>Filter</h2>
    <button class="reset" id="reset">Alle zurücksetzen</button>

    <div class="fgroup">
      <span class="flabel">Vermarktungsart</span>
      <div class="seg" id="dealSeg"><button class="active" data-v="miete">Miete</button><button data-v="kauf">Kauf</button></div>
    </div>
    <div class="fgroup">
      <span class="flabel">Objektart</span>
      <select id="art">
        <option value="all">Alle Objektarten</option>
        <option value="buero">Büro- / Praxisflächen</option>
        <option value="halle">Halle / Lager / Produktion</option>
      </select>
    </div>
    <div class="fgroup">
      <span class="flabel">Stadt</span>
      <select id="city"><option value="all">Alle Standorte</option></select>
    </div>
    <div class="fgroup">
      <span class="flabel">Fläche (m²)</span>
      <div class="numrow"><input type="number" id="amin" placeholder="von" min="0"><input type="number" id="amax" placeholder="bis" min="0"></div>
    </div>
    <div class="fgroup">
      <span class="flabel">Mietpreis bis (€/m²)</span>
      <div class="rangeval"><span>5 €</span><b id="pmaxVal">egal</b></div>
      <input type="range" id="pmax" min="5" max="20" step="1" value="20">
    </div>
    <button class="closef" id="closef">Ergebnisse anzeigen</button>
  </aside>

  <!-- RESULTS -->
  <main>
    <div class="rhead">
      <div class="rcount"><b id="count">0</b>Objekte</div>
      <div class="rtools">
        <button class="filter-open" id="filterOpen">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h18M6 12h12M10 19h4"/></svg> Filter
        </button>
        <select id="sort" aria-label="Sortierung">
          <option value="rel">Empfohlen</option>
          <option value="pa">Preis aufsteigend</option>
          <option value="pd">Preis absteigend</option>
          <option value="aa">Fläche aufsteigend</option>
          <option value="ad">Fläche absteigend</option>
        </select>
        <div class="viewtoggle">
          <button id="vGrid" class="active" aria-label="Rasteransicht"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg></button>
          <button id="vList" aria-label="Listenansicht"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="16" width="18" height="4" rx="1"/></svg></button>
        </div>
      </div>
    </div>
    <div class="grid" id="grid"></div>
  </main>
</div>

<!-- DETAIL MODAL -->
<div class="modal" id="modal" aria-modal="true" role="dialog">
  <div class="backdrop" id="backdrop"></div>
  <div class="sheet" id="sheet">
    <div class="sheet-top">
      <div class="sheet-nav">
        <button class="iconbtn" id="mPrev" aria-label="Vorheriges Objekt">&lsaquo;</button>
        <button class="iconbtn" id="mNext" aria-label="Nächstes Objekt">&rsaquo;</button>
      </div>
      <button class="iconbtn" id="mClose" aria-label="Schließen">&times;</button>
    </div>
    <div id="sheetContent"></div>
  </div>
</div>

<!-- FOOTER -->
<footer>
  <div class="wrap">
