function filtered(){
  let r=DATA.filter(o=>{
    if(state.deal==='kauf')return false; // aktueller Bestand ist Mietangebot
    if(state.art!=='all'&&o.type!==state.art)return false;
    if(state.city!=='all'&&o.city!==state.city)return false;
    if(state.q){const s=(o.title+' '+o.city+' '+o.plz+' '+o.street).toLowerCase();if(!s.includes(state.q.toLowerCase()))return false;}
    if(state.amin!=null&&o.area!=null&&o.area<state.amin)return false;
    if(state.amax!=null&&o.area!=null&&o.area>state.amax)return false;
    if(state.pmax<PMAX&&o.price!=null&&o.price>state.pmax)return false;
    return true;
  });
  const s=state.sort;
  const az=v=>v==null?Infinity:v, ad=v=>v==null?-Infinity:v;
  if(s==='pa')r.sort((a,b)=>az(a.price)-az(b.price));
  else if(s==='pd')r.sort((a,b)=>ad(b.price)-ad(a.price));
  else if(s==='aa')r.sort((a,b)=>az(a.area)-az(b.area));
  else if(s==='ad')r.sort((a,b)=>ad(b.area)-ad(a.area));
  else r.sort((a,b)=>(b.exclusive-a.exclusive)||ad(b.area)-ad(a.area));
  return r;
}
