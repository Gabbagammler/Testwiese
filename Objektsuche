document.getElementById('mClose').onclick=closeDetail;
document.getElementById('backdrop').onclick=closeDetail;
document.getElementById('mPrev').onclick=()=>nav(-1);
document.getElementById('mNext').onclick=()=>nav(1);
addEventListener('keydown',e=>{if(!modal.classList.contains('open'))return;if(e.key==='Escape')closeDetail();if(e.key==='ArrowRight')nav(1);if(e.key==='ArrowLeft')nav(-1)});

document.getElementById('q').addEventListener('input',e=>{state.q=e.target.value;render()});
document.getElementById('art').addEventListener('change',e=>{state.art=e.target.value;render()});
citySel.addEventListener('change',e=>{state.city=e.target.value;render()});
document.getElementById('amin').addEventListener('input',e=>{state.amin=e.target.value?+e.target.value:null;render()});
document.getElementById('amax').addEventListener('input',e=>{state.amax=e.target.value?+e.target.value:null;render()});
const pmax=document.getElementById('pmax'),pmaxVal=document.getElementById('pmaxVal');
pmax.addEventListener('input',e=>{state.pmax=+e.target.value;pmaxVal.textContent=state.pmax>=PMAX?'egal':state.pmax+' €';render()});
document.getElementById('sort').addEventListener('change',e=>{state.sort=e.target.value;render()});
document.querySelectorAll('#dealSeg button').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('#dealSeg button').forEach(x=>x.classList.remove('active'));b.classList.add('active');state.deal=b.dataset.v;render();
}));
const vGrid=document.getElementById('vGrid'),vList=document.getElementById('vList');
vGrid.onclick=()=>{state.view='grid';vGrid.classList.add('active');vList.classList.remove('active');render()};
vList.onclick=()=>{state.view='list';vList.classList.add('active');vGrid.classList.remove('active');render()};

function resetAll(){
  Object.assign(state,{q:'',deal:'miete',art:'all',city:'all',amin:null,amax:null,pmax:PMAX,sort:'rel'});
  document.getElementById('q').value='';document.getElementById('art').value='all';citySel.value='all';
  document.getElementById('amin').value='';document.getElementById('amax').value='';
  pmax.value=PMAX;pmaxVal.textContent='egal';document.getElementById('sort').value='rel';
  document.querySelectorAll('#dealSeg button').forEach((x,i)=>x.classList.toggle('active',i===0));
  render();
}
document.getElementById('reset').onclick=resetAll;

/* Mobile filter drawer */
const filtersEl=document.getElementById('filters');
document.getElementById('filterOpen').onclick=()=>{filtersEl.classList.add('open');document.body.classList.add('lock')};
document.getElementById('closef').onclick=()=>{filtersEl.classList.remove('open');document.body.classList.remove('lock')};
document.getElementById('merkBtn').onclick=()=>{
  if(!fav.size){alert('Ihre Merkliste ist noch leer. Tippen Sie auf das Herz an einem Objekt.');return;}
  state.q='';document.getElementById('q').value='';
  current=DATA.filter(o=>fav.has(o.id));countEl.textContent=current.length;
  grid.className='grid'+(state.view==='list'?' list':'');grid.innerHTML=current.map(card).join('');
  scrollTo({top:document.querySelector('.layout').offsetTop-70,behavior:'smooth'});
};

render();
</script>
</body>
</html>
