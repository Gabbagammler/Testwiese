/* ---------- Vorschaubild (SVG, deterministisch je Objekt) ---------- */
function thumb(o,ctx,salt){
  salt=salt||0;
  const base=CITYBASE[o.city]||'#3A3530';
  let h=salt*7919;for(const c of o.title)h=(h*31+c.charCodeAt(0))>>>0;
  const rnd=n=>{h=(h*1103515245+12345)>>>0;return (h>>>8)%1000/1000*n};
  const gid='g'+o.id+ctx+salt;
  let b='';
  if(o.type==='halle'){
    b+=`<polygon points='30,160 200,116 370,160 370,232 30,232' fill='rgba(255,255,255,.06)'/>`;
    b+=`<polygon points='30,160 200,116 370,160' fill='rgba(255,255,255,.04)'/>`;
    for(let i=0;i<7;i++)b+=`<rect x='${48+i*46}' y='176' width='26' height='40' fill='rgba(255,255,255,.07)'/>`;
    b+=`<rect x='250' y='150' width='34' height='${rnd(30)+30}' fill='rgba(240,90,40,.5)'/>`;
  }else{
    const n=4+Math.floor(rnd(4));let x=34;
    for(let i=0;i<n;i++){const w=42+rnd(46),ht=80+rnd(120),y=232-ht;
      b+=`<rect x='${x.toFixed(0)}' y='${y.toFixed(0)}' width='${w.toFixed(0)}' height='${ht.toFixed(0)}' fill='rgba(255,255,255,.06)'/>`;
      for(let wy=y+12;wy<224;wy+=18)for(let wx=x+8;wx<x+w-10;wx+=15){const lit=rnd(1)>.82;b+=`<rect x='${wx.toFixed(0)}' y='${wy.toFixed(0)}' width='6' height='9' fill='${lit?'rgba(240,90,40,.85)':'rgba(255,255,255,.13)'}'/>`}
      x+=w+9;if(x>360)break;
    }
  }
  return `<svg viewBox='0 0 400 250' preserveAspectRatio='xMidYMid slice' xmlns='http://www.w3.org/2000/svg'>`
    +`<defs><linearGradient id='${gid}' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='${base}'/><stop offset='1' stop-color='#14110F'/></linearGradient></defs>`
    +`<rect width='400' height='250' fill='url(#${gid})'/>${b}`
    +`<polygon points='400,250 400,176 312,250' fill='rgba(240,90,40,.9)'/></svg>`;
}

