 const dup=DEALS.map(d=>dealCard(d).replace('<a class="ocard"','<a class="ocard" aria-hidden="true" tabindex="-1"')).join('');
 oTrack.innerHTML=DEALS.map(dealCard).join('')+dup;
 const SPEED=62;
 let half=0,offset=0,paused=false,visible=true,last=performance.now();
 function measure(){
  const first=oTrack.children[0],second=oTrack.children[DEALS.length];
  if(first&&second)half=second.offsetLeft-first.offsetLeft;
 }
 function wrap(){
  if(half<=0)return;
  while(offset<=-half)offset+=half;
  while(offset>0)offset-=half;
 }
 function apply(){oTrack.style.transform=`translate3d(${offset}px,0,0)`;}
 let dragging=false,startX=0,startOff=0,moved=false,vel=0,lastX=0,lastT=0;
 function frame(now){
  const dt=Math.min(.05,(now-last)/1000);last=now;
  if(!dragging){
   if(!paused&&visible&&half>0)offset-=SPEED*dt;
   if(Math.abs(vel)>4){offset+=vel*dt;vel*=.9;}else vel=0;
   wrap();apply();
  }
  requestAnimationFrame(frame);
 }
 const px=e=>e.touches?e.touches[0].clientX:e.clientX;
 function onDown(e){
  dragging=true;moved=false;vel=0;
  startX=lastX=px(e);startOff=offset;lastT=performance.now();
  oMarquee.classList.add('grabbing');
 }
 function onMove(e){
  if(!dragging)return;
  const x=px(e),dx=x-startX;
  if(Math.abs(dx)>4)moved=true;
  offset=startOff+dx;wrap();apply();
  const t=performance.now(),d=t-lastT;
  if(d>0){vel=(x-lastX)/d*1000;lastX=x;lastT=t;}
 }
 function onUp(){
  if(!dragging)return;
  dragging=false;last=performance.now();
  oMarquee.classList.remove('grabbing');
 }
 oMarquee.addEventListener('mousedown',onDown);
 addEventListener('mousemove',onMove,{passive:true});
 addEventListener('mouseup',onUp);
 oMarquee.addEventListener('touchstart',onDown,{passive:true});
 oMarquee.addEventListener('touchmove',onMove,{passive:true});
 oMarquee.addEventListener('touchend',onUp);
 oMarquee.addEventListener('touchcancel',onUp);
 oMarquee.addEventListener('dragstart',e=>e.preventDefault());
 oTrack.addEventListener('click',e=>{if(moved)e.preventDefault();},true);
 oMarquee.addEventListener('mouseenter',()=>paused=true);
 oMarquee.addEventListener('mouseleave',()=>paused=false);
 new IntersectionObserver(es=>es.forEach(e=>{visible=e.isIntersecting;}),{threshold:0}).observe(oMarquee);
 let oRt;addEventListener('resize',()=>{clearTimeout(oRt);oRt=setTimeout(()=>{measure();wrap();apply();},200);});
 requestAnimationFrame(()=>requestAnimationFrame(()=>{measure();wrap();apply();last=performance.now();requestAnimationFrame(frame);}));
}

