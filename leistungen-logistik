.rsb-in>div{flex:1 1 min(100%,560px);min-width:0}
.rsb h2{font-family:'Benton Wide';font-weight:900;text-transform:uppercase;line-height:.95;
  font-size:clamp(1.6rem,2.8vw,2.3rem);max-width:17ch}
.rsb h2 em{font-style:normal;color:var(--orange)}
.rsb p{color:var(--grey);font-size:1rem;line-height:1.75;margin-top:clamp(16px,2vw,22px);max-width:54ch}
