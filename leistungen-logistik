.cta .lead-q{font-size:clamp(1.15rem,2vw,1.6rem);font-weight:500;letter-spacing:-.02em;line-height:1.35;color:rgba(255,255,255,.74)}
.cta .big-q{font-family:'Benton Wide';font-weight:900;text-transform:uppercase;font-size:clamp(2.5rem,5.8vw,4.8rem);line-height:.95;color:#fff;margin-top:14px}
.cta .big-q em{font-style:normal;color:var(--orange)}
.cta p{color:var(--grey-d);max-width:46ch;margin:22px 0 0}
.cta .acts{display:flex;gap:14px;margin-top:38px;flex-wrap:wrap}
/* Ansprechpartner: eine gemeinsame Flaeche, beide Personen gleichwertig,
   groessere Portraits und Namen in der Subheadline-Schrift (Inter), keine Visitenkarten-Optik. */
.cta-team{position:relative;background:linear-gradient(165deg,rgba(255,255,255,.08),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.12);border-radius:22px;padding:clamp(24px,2.8vw,38px);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.cta-team::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;background:linear-gradient(160deg,rgba(255,111,32,.6),transparent 44%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
.cta-team .tt{font-family:'IBM Plex Mono';font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--orange);margin-bottom:clamp(20px,2.4vw,28px)}
.cperson{display:flex;align-items:center;gap:clamp(18px,2.2vw,26px);padding:clamp(20px,2.4vw,28px) 0;border-top:1px solid rgba(255,255,255,.1)}
.cperson img{width:clamp(76px,6.6vw,104px);height:clamp(76px,6.6vw,104px);border-radius:50%;object-fit:cover;object-position:50% 22%;flex:0 0 auto;background:var(--bg2);box-shadow:0 0 0 2px var(--bg),0 0 0 4px rgba(255,111,32,.6)}
.cperson .cn{font-family:'Inter',sans-serif;font-weight:700;text-transform:none;letter-spacing:-.02em;
  font-size:clamp(1.08rem,1.5vw,1.26rem);line-height:1.15;color:#fff}
.cperson .cr{font-size:.85rem;color:var(--grey-d);margin-top:6px;line-height:1.35}
.cperson .cl{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:12px}
.cperson .cl a{display:inline-flex;align-items:center;gap:8px;font-size:.88rem;color:#fff;transition:.25s}
.cperson .cl a:hover{color:var(--orange)}
.cperson .cl a svg{width:14px;height:14px;fill:none;stroke:var(--orange);stroke-width:1.7;flex:0 0 auto}
@media(max-width:860px){.cta-grid{grid-template-columns:1fr}}
@media(max-width:460px){.cperson{align-items:flex-start;gap:16px}
 .cperson img{width:66px;height:66px}.cperson .cl{gap:4px 14px}}

/* ===== FOOTER ===== */
footer{background:var(--bg);color:#fff;padding-bottom:30px}
.foot-grid{border-top:1px solid var(--line-d);display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr 1fr;gap:clamp(24px,3.4vw,48px);padding:clamp(50px,6vw,80px) 0}
.foot-brand .flogo svg{height:26px;width:auto;margin-bottom:20px}
.foot-brand .flogo svg path{fill:#fff!important}
.foot-brand p{color:var(--grey-d);font-size:.86rem;max-width:32ch;margin-bottom:22px}
.foot-soc{display:flex;gap:10px}
.foot-soc a{width:40px;height:40px;border-radius:50%;border:1px solid var(--line-d);display:flex;align-items:center;justify-content:center;transition:.3s}
.foot-soc a:hover{background:var(--orange);border-color:var(--orange)}
.foot-soc svg{width:16px;height:16px;fill:#fff}
