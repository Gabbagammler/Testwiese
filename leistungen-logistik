<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Industrial &amp; Logistics | CUBION Immobilien AG</title>
<link rel="icon" type="image/png" sizes="32x32" href="data:image/png;base64,">
<link rel="icon" type="image/png" sizes="128x128" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<meta name="description" content="Industrial &amp; Logistics: CUBION vermittelt Hallen-, Lager-, Logistik- und Produktionsflächen im Ruhrgebiet. Beratung für Unternehmen auf Flächensuche und für Eigentümer – von der Bedarfsklärung bis zum Abschluss.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
@font-face{font-family:'Benton Wide';src:url(data:font/woff2;base64,) format('woff2');font-weight:900;font-style:normal;font-display:swap}
:root{
  --bg:#0e0c0b;--bg2:#171412;--ink:#1B1714;--paper:#fff;--bone:#F4F3F0;--bone2:#ECEAE5;--line:#E4E2DD;
  --grey:#84817C;--grey2:#B4B1AB;--grey-d:rgba(255,255,255,.56);--line-d:rgba(255,255,255,.12);
  --orange:#ff6f20;--orange2:#ff8442;
  --maxw:1340px;--gut:clamp(18px,4vw,60px);--ease:cubic-bezier(.22,1,.36,1);--ease2:cubic-bezier(.16,1,.3,1);
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{font-family:'Inter',system-ui,sans-serif;background:var(--paper);color:var(--ink);line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
body.lock{overflow:hidden;height:100vh}
img{display:block;max-width:100%}a{color:inherit;text-decoration:none}
::selection{background:var(--orange);color:#fff}
:focus-visible{outline:2px solid var(--orange);outline-offset:3px}
.wrap{max-width:var(--maxw);margin:0 auto;padding-inline:var(--gut)}
.benton{font-family:'Benton Wide',sans-serif;font-weight:900;text-transform:uppercase;line-height:.92;letter-spacing:-.005em}
.mono{font-family:'IBM Plex Mono',monospace}
.eyebrow{font-family:'IBM Plex Mono';font-size:1.08rem;letter-spacing:.2em;text-transform:uppercase;color:var(--grey)}
.eyebrow .dot{color:var(--orange)}
/* Einheitliche Modulkennzeichnung: orangefarbene Orientierungsschrift ueber jeder Headline */
.lead{display:block;font-family:'IBM Plex Mono',monospace;font-weight:500;
      font-size:clamp(.92rem,1.15vw,1.12rem);letter-spacing:.22em;text-transform:uppercase;
      color:var(--orange);margin-bottom:clamp(16px,1.8vw,26px)}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:12px;font-size:.86rem;font-weight:500;padding:15px 26px;border-radius:100px;cursor:pointer;border:1px solid transparent;transition:transform .4s var(--ease),background .3s,color .3s,border-color .3s;white-space:nowrap}
.btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2}
.btn-o{background:var(--orange);color:#fff}.btn-o:hover{background:var(--orange2)}
.btn-dk{background:var(--ink);color:#fff}.btn-dk:hover{background:var(--orange)}
.btn-gh{border-color:var(--line);color:var(--ink)}.btn-gh:hover{border-color:var(--ink)}
.btn-gd{border-color:var(--line-d);color:#fff}.btn-gd:hover{background:#fff;color:var(--ink);border-color:#fff}
.btn-w{background:#fff;color:var(--ink);font-weight:600}.btn-w:hover{background:var(--orange);color:#fff}

/* reveal primitives */
.rv{opacity:0;transform:translateY(30px);transition:opacity .9s var(--ease2),transform .9s var(--ease2)}
.rv.in{opacity:1;transform:none}
.d1{transition-delay:.08s}.d2{transition-delay:.16s}.d3{transition-delay:.24s}.d4{transition-delay:.32s}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.rv{opacity:1!important;transform:none!important;transition:none}}

/* ===== NAV (white) ===== */
.nav{position:fixed;top:0;left:0;right:0;z-index:110;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:0 var(--gut);height:76px;background:rgba(255,255,255,.94);backdrop-filter:blur(18px) saturate(1.3);-webkit-backdrop-filter:blur(18px) saturate(1.3);border-bottom:1px solid var(--line);color:var(--ink)}
#prog{position:absolute;left:0;bottom:-1px;height:2px;width:0;background:linear-gradient(90deg,var(--orange),var(--orange2));z-index:4}
.nav .logo{display:flex;align-items:center}
.nav .logo svg{height:30px;width:auto;display:block}
.nav .right{display:flex;align-items:center;gap:clamp(14px,2vw,26px)}
.navlinks{display:flex;align-items:center;gap:clamp(4px,1vw,10px)}
.nl{position:relative}
.nl>a{display:flex;align-items:center;gap:7px;font-size:.94rem;font-weight:500;color:var(--ink);padding:10px 13px;border-radius:100px;transition:background .25s,color .25s}
.nl>a:hover{background:var(--bone)}
.nl.hasdd:hover>a,.nl.hasdd:focus-within>a{background:#fff;border-radius:14px 14px 0 0;color:var(--orange)}
.nl>a .car{width:9px;height:9px;flex:0 0 auto;fill:none;stroke:var(--grey);stroke-width:2;transition:transform .3s var(--ease)}
.nl:hover>a .car{transform:rotate(180deg);stroke:var(--orange)}
.nl>a.cta-link{background:var(--ink);color:#fff;padding:11px 20px}
.nl>a.cta-link:hover{background:var(--orange)}
.nl>a.on{color:var(--orange)}
.dd{position:absolute;top:100%;left:0;transform:translateY(5px);background:#fff;border-radius:0 16px 16px 16px;box-shadow:0 36px 70px -28px rgba(27,23,20,.4);padding:2px 10px 10px;min-width:236px;opacity:0;pointer-events:none;transition:opacity .26s var(--ease),transform .26s var(--ease)}
.nl:hover .dd,.nl:focus-within .dd{opacity:1;pointer-events:auto;transform:none}
.dd::before{content:"";display:block;height:1px;background:var(--line);margin:2px 6px 8px}
.dd a{display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:.88rem;font-weight:500;padding:11px 14px;border-radius:10px;transition:background .2s,color .2s;white-space:nowrap}
.dd a:hover{background:var(--bone);color:var(--orange)}
.dd a.on{color:var(--orange)}
.dd a .go{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:2;opacity:0;transform:translateX(-4px);transition:.25s}
.dd a:hover .go{opacity:1;transform:none}
.nav .mbtn{display:flex;align-items:center;gap:11px;font-family:'IBM Plex Mono';font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;background:none;border:0;color:inherit;padding:0}
.nav .mbtn .ic{display:flex;flex-direction:column;gap:5px}
.nav .mbtn .ic i{width:24px;height:2px;background:currentColor;display:block;transition:.3s}
@media(max-width:1240px){.nav .mbtn .txt{display:none}}
@media(max-width:1080px){.navlinks{display:none}.nav .mbtn .txt{display:inline}}
@media(max-width:640px){.nav{height:64px}.nav .logo svg{height:24px}.nav .mbtn .txt{display:none}}

/* ===== MERKLISTE (Nav-Lesezeichen) ===== */
.merk{position:relative;display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;color:var(--ink);flex:0 0 auto;transition:background .25s,color .25s}
.merk:hover{background:var(--bone)}
.merk svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;transition:fill .25s,stroke .25s}
.merk.filled svg{fill:var(--orange);stroke:var(--orange)}
.merk-badge{position:absolute;top:1px;right:0;min-width:17px;height:17px;padding:0 4px;border-radius:100px;background:var(--orange);color:#fff;font-family:'IBM Plex Mono';font-size:.6rem;line-height:1;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 2px rgba(255,255,255,.94);pointer-events:none}
.merk-badge[hidden]{display:none}
.merk.bump{animation:merkBump .5s var(--ease)}
@keyframes merkBump{0%{transform:scale(1)}30%{transform:scale(1.26)}60%{transform:scale(.92)}100%{transform:scale(1)}}
@media(prefers-reduced-motion:reduce){.merk.bump{animation:none}}
@media(max-width:640px){.merk{width:38px;height:38px}.merk svg{width:19px;height:19px}}

/* ===== SECTION RAIL ===== */
#rail{position:fixed;right:max(22px,2vw);top:50%;transform:translateY(-50%) translateX(10px);z-index:90;display:flex;flex-direction:column;gap:19px;mix-blend-mode:difference;align-items:flex-end;opacity:0;visibility:hidden;transition:opacity .55s var(--ease),transform .55s var(--ease),visibility .55s}
#rail.show{opacity:1;visibility:visible;transform:translateY(-50%)}
#rail a{display:flex;align-items:center;gap:14px;justify-content:flex-end;color:#fff;height:18px}
#rail .lab{font-family:'IBM Plex Mono';font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;opacity:.48;transition:.35s var(--ease);white-space:nowrap}
#rail a:hover .lab{opacity:.9}
#rail a.act .lab{opacity:1;font-size:.86rem;letter-spacing:.14em}
#rail .tick{width:20px;height:2px;background:#fff;opacity:.5;transition:.35s var(--ease);flex:0 0 auto}
#rail a:hover .tick{opacity:.9;width:28px}
#rail a.act .tick{width:46px;height:3px;opacity:1;background:var(--orange)}
@media(max-width:1180px){#rail{display:none}}

/* ===== ACTION STACK ===== */
#stack{position:fixed;bottom:clamp(22px,4vh,42px);right:max(20px,2.2vw);z-index:115;display:flex;flex-direction:column;gap:12px;align-items:flex-end}
.act-item{position:relative;display:flex;align-items:center}
.act-btn{width:50px;height:50px;border-radius:50%;background:var(--ink);color:var(--orange);border:0;cursor:pointer;display:flex;align-items:center;justify-content:center;flex:0 0 auto;transition:transform .3s var(--ease),background .3s;box-shadow:0 14px 30px -12px rgba(0,0,0,.55)}
.act-btn:hover{transform:scale(1.07);background:#000}
.act-btn svg{width:21px;height:21px;fill:none;stroke:var(--orange);stroke-width:1.8}
.act-tip{position:absolute;right:calc(100% + 12px);top:50%;transform:translate(8px,-50%);background:var(--ink);color:#fff;font-family:'IBM Plex Mono';font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;padding:8px 13px;border-radius:8px;white-space:nowrap;opacity:0;pointer-events:none;transition:.3s var(--ease)}
.act-item:hover .act-tip{opacity:1;transform:translate(0,-50%)}
#contactBtn{position:relative}
#contactBtn::before{content:"";position:absolute;inset:0;border-radius:50%;border:1.5px solid var(--orange);animation:cpulse 3s ease-out infinite;pointer-events:none}
@keyframes cpulse{0%{transform:scale(1);opacity:.32}100%{transform:scale(1.6);opacity:0}}
@media(prefers-reduced-motion:reduce){#contactBtn::before{animation:none;opacity:0}}
#topItem{opacity:0;pointer-events:none;transform:translateY(8px);transition:.4s var(--ease)}
#topItem.show{opacity:1;pointer-events:auto;transform:none}

/* contact card */
#contactCard{position:fixed;bottom:calc(clamp(22px,4vh,42px) + 62px);right:max(20px,2.2vw);z-index:114;transform-origin:bottom right;background:rgba(23,20,18,.86);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.13);border-radius:18px;padding:22px 24px;color:#fff;width:290px;opacity:0;transform:translateY(8px) scale(.96);pointer-events:none;transition:.38s var(--ease);box-shadow:0 36px 70px -34px rgba(0,0,0,.7)}
#contactCard.open{opacity:1;transform:none;pointer-events:auto}
#contactCard .chead{display:flex;align-items:center;gap:14px;margin-bottom:16px}
#contactCard .cav{width:56px;height:56px;border-radius:50%;object-fit:cover;flex:0 0 auto;border:2px solid rgba(255,255,255,.22);background:var(--bg2)}
#contactCard .ct{font-family:'IBM Plex Mono';font-size:.56rem;letter-spacing:.18em;text-transform:uppercase;color:var(--orange);margin-bottom:5px}
/* Ansprechpartner-Name: Subheadline-Schrift (Inter), bewusst nicht Benton Wide und nicht in Versalien */
#contactCard .cn{font-family:'Inter',sans-serif;font-weight:700;font-size:1.02rem;letter-spacing:-.02em;line-height:1.15}
#contactCard .cr{font-size:.8rem;color:rgba(255,255,255,.6);margin-top:4px}
#contactCard a{display:flex;align-items:center;gap:11px;color:#fff;font-size:.86rem;padding:8px 0;transition:.2s}
#contactCard a:hover{color:var(--orange)}
#contactCard a svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;flex:0 0 auto}

/* quick search panel */
#qsearch{position:fixed;bottom:calc(clamp(22px,4vh,42px) + 62px);right:max(20px,2.2vw);z-index:114;transform-origin:bottom right;width:min(340px,calc(100vw - 40px));background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;opacity:0;transform:translateY(12px) scale(.94);pointer-events:none;transition:.42s var(--ease2);box-shadow:0 44px 90px -40px rgba(27,23,20,.55)}
#qsearch.open{opacity:1;transform:none;pointer-events:auto}
#qsearch .qimg{position:relative;height:150px;overflow:hidden;background:var(--bone2)}
#qsearch .qimg img{width:100%;height:100%;object-fit:cover;transform:scale(1.08);transition:transform 1.4s var(--ease2)}
#qsearch.open .qimg img{transform:scale(1)}
#qsearch .qimg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,12,11,.05),rgba(14,12,11,.55))}
#qsearch .qimg .qt{position:absolute;left:18px;bottom:14px;z-index:2;color:#fff;font-family:'Benton Wide';font-weight:900;text-transform:uppercase;font-size:1.05rem}
#qsearch .qbody{padding:18px}
#qsearch .qf{padding:12px 14px;border:1px solid var(--line);border-radius:12px;margin-bottom:10px;position:relative}
#qsearch .qf label{display:block;font-family:'IBM Plex Mono';font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:var(--grey);margin-bottom:5px}
#qsearch .qf select{appearance:none;background:none;border:0;color:var(--ink);font-family:'Inter';font-weight:600;font-size:.9rem;width:100%;cursor:pointer;padding-right:20px}
#qsearch .qf::after{content:"";position:absolute;right:15px;bottom:20px;width:7px;height:7px;border-right:1.5px solid var(--grey);border-bottom:1.5px solid var(--grey);transform:rotate(45deg);pointer-events:none}
#qsearch .btn{width:100%;justify-content:center;margin-top:4px}

/* ===== BURGER MENU ===== */
#menu{position:fixed;inset:0;z-index:200;background:var(--bg);color:#fff;clip-path:circle(0 at calc(100% - 60px) 44px);transition:clip-path .7s var(--ease2);display:flex;flex-direction:column;padding:clamp(24px,4vw,56px) var(--gut);overflow-y:auto}
#menu.open{clip-path:circle(160% at calc(100% - 60px) 44px)}
#menu .mtop{display:flex;justify-content:space-between;align-items:center;flex:0 0 auto}
#menu .mlogo svg{height:26px;width:auto}
#menu .mlogo svg path{fill:#fff!important}
#menu .mclose{font-family:'IBM Plex Mono';font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;background:none;border:0;color:#fff;display:flex;gap:10px;align-items:center}
#menu nav{margin:auto 0;display:flex;flex-direction:column;padding:34px 0}
.mgrp{border-bottom:1px solid rgba(255,255,255,.09)}
.mgrp>a,.mgrp>button{width:100%;text-align:left;display:flex;align-items:baseline;justify-content:space-between;gap:16px;font-family:'Benton Wide';font-weight:900;text-transform:uppercase;font-size:clamp(1.5rem,5.6vw,2.7rem);line-height:1.05;color:#fff;background:none;border:0;cursor:pointer;padding:clamp(14px,2.2vw,20px) 0;transition:color .3s}
.mgrp>a:hover,.mgrp>button:hover{color:var(--orange)}
.mgrp .pm{font-family:'IBM Plex Mono';font-size:1.1rem;color:var(--grey);transition:transform .35s var(--ease);flex:0 0 auto}
.mgrp.open .pm{transform:rotate(45deg);color:var(--orange)}
.msub{max-height:0;overflow:hidden;transition:max-height .5s var(--ease)}
.mgrp.open .msub{max-height:400px}
.msub a{display:block;font-size:1rem;font-weight:500;color:rgba(255,255,255,.72);padding:9px 0 9px 4px;transition:.25s}
.msub a:hover{color:var(--orange);padding-left:12px}
.msub a.on{color:var(--orange)}
.msub{padding-bottom:0}.mgrp.open .msub{padding-bottom:18px}
#menu .mfoot{display:flex;gap:28px;font-family:'IBM Plex Mono';font-size:.74rem;color:var(--grey-d);flex-wrap:wrap;flex:0 0 auto}

/* ===== HERO (Bild, dunkel) =====
   Aufbau identisch zu Buerovermietung und Investment: grosse Bildflaeche, Textseite links,
   transparente Kennzahlenflaeche rechts. Bildwechsel nur ueber die URL in .lhero-media img,
   der Bildschnitt ueber object-position. */
.lhero{position:relative;z-index:5;min-height:min(90svh,810px);color:#fff;display:flex;align-items:center;
       padding:clamp(146px,18vh,190px) var(--gut) clamp(64px,8vh,96px);overflow:hidden;background:var(--bg)}
.lhero-media{position:absolute;inset:0;z-index:0;overflow:hidden}
.lhero-media img{width:100%;height:100%;object-fit:cover;object-position:56% 56%;filter:saturate(.84) contrast(1.06);transform:scale(1.06)}
.loaded .lhero-media img{transform:scale(1);transition:transform 2.8s var(--ease2)}
.lhero-media::after{content:"";position:absolute;inset:0;background:
  linear-gradient(84deg,rgba(14,12,11,.96) 0%,rgba(14,12,11,.88) 34%,rgba(14,12,11,.56) 64%,rgba(14,12,11,.32) 100%),
  linear-gradient(180deg,rgba(14,12,11,.6) 0%,rgba(14,12,11,0) 26%,rgba(14,12,11,.5) 74%,rgba(14,12,11,.9) 100%)}
.lhero-wash{position:absolute;inset:0;z-index:1;pointer-events:none;background:
  radial-gradient(64% 54% at 2% 102%,rgba(255,111,32,1) 0%,rgba(255,111,32,.7) 22%,rgba(255,111,32,.32) 44%,rgba(255,111,32,.08) 62%,rgba(255,111,32,0) 76%)}
.lhero-inner{position:relative;z-index:2;width:100%;max-width:var(--maxw);margin:0 auto;
  display:grid;grid-template-columns:minmax(0,1fr) minmax(268px,auto);gap:clamp(30px,3.6vw,64px);align-items:start}
.lhero-copy{max-width:min(100%,824px)}
.lhero .lead{opacity:0}
.loaded .lhero .lead{opacity:1;transition:opacity .9s var(--ease2) .1s}
.lhero h1{font-family:'Benton Wide';font-weight:900;text-transform:uppercase;
          font-size:clamp(1.8rem,3.3vw,3rem);line-height:.94;letter-spacing:-.015em;color:#fff}
.lhero h1 .ln{display:block;overflow:hidden;white-space:nowrap;padding-top:.1em;margin-top:-.1em}
.lhero h1 .ln i{display:block;font-style:normal;transform:translateY(112%)}
.loaded .lhero h1 .ln i{transform:none;transition:transform 1.05s var(--ease2) .1s}
.loaded .lhero h1 .ln:nth-child(2) i{transition-delay:.2s}
.lhero h1 em{font-style:normal;color:var(--orange)}
.lhero .sub{max-width:52ch;margin-top:clamp(22px,2.6vw,32px);color:rgba(255,255,255,.85);
            font-size:clamp(1rem,1.2vw,1.16rem);line-height:1.72;opacity:0}
.loaded .lhero .sub{opacity:1;transition:opacity 1s var(--ease2) .5s}
.lhero .acts{margin-top:clamp(26px,3.2vw,38px);display:flex;gap:13px;flex-wrap:wrap;opacity:0}
.loaded .lhero .acts{opacity:1;transition:opacity 1s var(--ease2) .62s}

/* Kennzahlenflaeche rechts: leichte Glasflaeche, keine schwere Box.
   Benton nur fuer die Zahl, alles andere Inter. */
.hfacts{align-self:start;justify-self:end;position:relative;
  margin-top:clamp(0px,4.2vw,62px);width:clamp(268px,23vw,330px);
  background:rgba(16,13,11,.4);
  backdrop-filter:blur(20px) saturate(1.2);-webkit-backdrop-filter:blur(20px) saturate(1.2);
  border:1px solid rgba(255,255,255,.2);border-radius:20px;
  padding:clamp(22px,2.3vw,28px) clamp(24px,2.5vw,32px) clamp(24px,2.5vw,30px);
  box-shadow:0 34px 64px -38px rgba(0,0,0,.72),inset 0 1px 0 rgba(255,255,255,.14);opacity:0}
.loaded .hfacts{opacity:1;transition:opacity 1s var(--ease2) .74s}
.hfacts .ht{font-size:.9rem;font-weight:500;line-height:1.5;color:rgba(255,255,255,.6);
  padding-bottom:clamp(16px,1.6vw,20px);border-bottom:1px solid rgba(255,255,255,.16)}
.hfacts .hf{padding-top:clamp(16px,1.7vw,21px)}
.hfacts .v{font-family:'Benton Wide';font-weight:900;color:#fff;line-height:1;white-space:nowrap;
           font-size:clamp(1.5rem,1.85vw,1.85rem);letter-spacing:-.01em}
.hfacts .l{font-size:.95rem;font-weight:500;color:rgba(255,255,255,.72);margin-top:8px;line-height:1.45}
@media(max-width:1024px){
 .lhero{min-height:auto;align-items:stretch;padding:clamp(118px,17vh,158px) var(--gut) clamp(48px,7vw,70px)}
 .lhero-inner{grid-template-columns:1fr;gap:clamp(34px,6vw,48px)}
 .lhero-copy{max-width:none}
 .lhero-media img{object-position:58% 48%}
 .lhero-media::after{background:
   linear-gradient(180deg,rgba(14,12,11,.72) 0%,rgba(14,12,11,.5) 22%,rgba(14,12,11,.62) 58%,rgba(14,12,11,.93) 100%)}
 .lhero-wash{background:radial-gradient(112% 44% at 22% 110%,rgba(255,111,32,1) 0%,rgba(255,111,32,.62) 26%,rgba(255,111,32,.22) 48%,rgba(255,111,32,0) 70%)}
 .hfacts{justify-self:stretch;width:auto;margin-top:0}
}
@media(max-width:560px){.lhero h1 .ln{white-space:normal}.lhero h1{font-size:clamp(1.9rem,8.8vw,2.7rem)}}
@media(prefers-reduced-motion:reduce){.lhero-media img{transform:none}.lhero h1 .ln i{transform:none}}

/* section head (global) */
.sec-head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:28px 40px;margin-bottom:clamp(38px,5vw,64px)}
.sec-head>div{flex:1 1 auto;min-width:0}
.sec-head h2{font-family:'Benton Wide';font-weight:900;text-transform:uppercase;line-height:.95;font-size:clamp(1.8rem,3.6vw,2.9rem);max-width:15ch}
.sec-head h2 em{font-style:normal;color:var(--orange)}
.sec-head .note{flex:0 1 clamp(280px,32%,430px);color:var(--grey);font-size:1rem;line-height:1.7;padding-bottom:6px}

/* ===== ZWEI PERSPEKTIVEN =====
   Beide Zustaende teilen Aufbau, Raster und Form. Der Wechsel aendert nur
   die Akzentfarbe (--acc) und die Inhalte, keine zweite Layoutlogik. */
.persp{background:var(--paper);padding:clamp(90px,12vw,150px) 0;--acc:var(--orange);--acc-ink:#fff}
.persp.b{--acc:var(--ink)}
.persp .sec-head{align-items:center}
.ptoggle{display:grid;grid-template-columns:1fr 1fr;background:var(--bone);border:1px solid var(--line);
  border-radius:100px;padding:5px;position:relative;min-width:min(430px,100%)}
.ptoggle .thumb{position:absolute;top:5px;bottom:5px;left:5px;width:calc(50% - 5px);background:var(--acc);
  border-radius:100px;transition:transform .5s var(--ease2),background .5s var(--ease2)}
.ptoggle.b .thumb{transform:translateX(100%)}
.ptoggle button{position:relative;z-index:2;padding:14px clamp(24px,3vw,42px);border-radius:100px;
  font-family:'Inter';font-weight:600;font-size:.95rem;border:0;background:none;cursor:pointer;
  color:var(--grey);transition:color .35s;white-space:nowrap}
.ptoggle button.on{color:var(--acc-ink)}
.ptoggle button:focus-visible{outline:2px solid var(--orange);outline-offset:3px}
.pstage{display:grid;margin-top:clamp(12px,2vw,22px)}
.pane{grid-area:1/1;display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(30px,5vw,90px);align-items:start;
  opacity:0;transform:translateY(14px);pointer-events:none;
  transition:opacity .5s var(--ease2),transform .5s var(--ease2)}
.pane.on{opacity:1;transform:none;pointer-events:auto}
.pane .pintro .kick{font-family:'IBM Plex Mono';font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--orange);display:block;margin-bottom:18px}
.pane .pintro .big{font-size:clamp(1.35rem,2.4vw,1.9rem);font-weight:500;letter-spacing:-.02em;line-height:1.3;max-width:20ch}
.pane .pintro p{color:var(--grey);font-size:.98rem;line-height:1.7;margin-top:16px;max-width:40ch}
.pane .pintro .btn{margin-top:28px;background:var(--acc);color:var(--acc-ink);transition:background .5s var(--ease2)}
.pane .pintro .btn:hover{background:var(--orange2)}
.persp.b .pane .pintro .btn:hover{background:var(--orange)}
.prows{border-top:1px solid var(--line)}
.prow{display:flex;gap:clamp(16px,2vw,24px);padding:clamp(18px,2.2vw,26px) 0;border-bottom:1px solid var(--line);
  align-items:flex-start;transition:padding-left .3s var(--ease)}
.prow:hover{padding-left:8px}
.prow .pic{width:46px;height:46px;border-radius:50%;background:var(--bone);display:flex;align-items:center;
  justify-content:center;flex:0 0 auto;transition:background .3s}
.prow:hover .pic{background:var(--acc)}
.prow .pic svg{width:19px;height:19px;fill:none;stroke:var(--ink);stroke-width:1.7;transition:stroke .3s}
.prow:hover .pic svg{stroke:var(--acc-ink)}
.prow h4{font-size:1.04rem;font-weight:600;letter-spacing:-.01em}
.prow p{color:var(--grey);font-size:.92rem;line-height:1.6;margin-top:5px;max-width:52ch}
@media(max-width:860px){.pane{grid-template-columns:1fr;gap:26px}.persp .sec-head{align-items:flex-start}.ptoggle{min-width:100%}}

/* ===== FLAECHENARTEN =====
   Dunkler Abschnitt. Links die Nutzungsarten als Auswahlliste, rechts eine Flaeche,
   die den ausgewaehlten Typ traegt. Bewusst kein Kachelraster: eine Aussage zur Zeit.
   Neue Nutzungsart: Button in .art-list und passendes .art-body ergaenzen (data-a gleich). */
.arts{background:var(--bg);color:#fff;padding:clamp(90px,12vw,150px) 0 clamp(84px,10vw,130px);position:relative;overflow:hidden}
.arts::before{content:"";position:absolute;right:-14%;top:-16%;width:62%;aspect-ratio:1;pointer-events:none;
  background:radial-gradient(circle,rgba(255,111,32,.15),transparent 66%)}
.arts .wrap{position:relative;z-index:1}
.arts .sec-head h2{color:#fff;max-width:16ch}
.arts .sec-head .note{color:var(--grey-d)}
.art-grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(28px,4.4vw,68px);align-items:start}
.art-list{border-top:1px solid var(--line-d)}
.art-item{width:100%;text-align:left;background:none;border:0;border-bottom:1px solid var(--line-d);
  color:rgba(255,255,255,.6);cursor:pointer;padding:clamp(15px,1.9vw,21px) 0;display:flex;align-items:center;
  gap:16px;font-family:'Inter',sans-serif;font-weight:600;font-size:clamp(1rem,1.35vw,1.14rem);letter-spacing:-.015em;
  line-height:1.3;transition:color .3s var(--ease),padding-left .35s var(--ease)}
.art-item .bar{width:14px;height:2px;background:rgba(255,255,255,.28);flex:0 0 auto;
  transition:width .45s var(--ease),background .35s,height .35s}
.art-item:hover{color:#fff}
.art-item:hover .bar{width:24px;background:rgba(255,255,255,.6)}
.art-item.on{color:#fff;padding-left:6px}
.art-item.on .bar{width:40px;height:3px;background:var(--orange)}
.art-panel{position:relative;display:grid;border-radius:24px;border:1px solid var(--line-d);
  background:linear-gradient(165deg,rgba(255,255,255,.07),rgba(255,255,255,.015));
  padding:clamp(26px,3.2vw,46px);min-height:clamp(322px,30vw,384px)}
.art-body{grid-area:1/1;opacity:0;transform:translateY(12px);pointer-events:none;
  transition:opacity .45s var(--ease2),transform .45s var(--ease2)}
.art-body.on{opacity:1;transform:none;pointer-events:auto}
.art-body .kick{display:block;font-family:'IBM Plex Mono';font-size:.68rem;letter-spacing:.2em;
  text-transform:uppercase;color:var(--orange);margin-bottom:clamp(18px,2vw,24px)}
.art-body h3{font-family:'Benton Wide';font-weight:900;text-transform:uppercase;line-height:.98;
  font-size:clamp(1.4rem,2.5vw,2.1rem);letter-spacing:-.01em;color:#fff;max-width:14ch}
.art-body p{color:var(--grey-d);font-size:1rem;line-height:1.75;margin-top:clamp(18px,2vw,24px);max-width:46ch}
.art-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:clamp(22px,2.6vw,30px)}
.art-tags span{font-family:'IBM Plex Mono';font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;
  padding:9px 14px;border-radius:100px;border:1px solid var(--line-d);color:rgba(255,255,255,.66)}
.arts .art-foot{margin-top:clamp(30px,3.6vw,46px);display:flex;align-items:center;justify-content:space-between;
  gap:20px 40px;flex-wrap:wrap}
.arts .art-foot p{color:var(--grey-d);font-size:.94rem;max-width:56ch}
@media(max-width:940px){.art-grid{grid-template-columns:1fr;gap:clamp(26px,5vw,36px)}
 .art-panel{min-height:0}.art-body h3{max-width:20ch}}

/* ===== STANDORTKOMPETENZ =====
   Das Achsendiagramm laeuft ueber die volle Spaltenbreite: es ist eine horizontale
   Grafik und braucht Breite, nicht Hoehe. Die vier Punkte stehen als Zeile darunter,
   damit der Abschnitt nicht wieder als Text-links-Bild-rechts liest. */
.loc{background:var(--bone);padding:clamp(90px,12vw,150px) 0 clamp(84px,10vw,130px)}
.axes{background:#fff;border-radius:24px;border:1px solid var(--line);padding:clamp(20px,2.6vw,34px)}
.axes .axhead{display:flex;align-items:baseline;justify-content:space-between;gap:12px 24px;flex-wrap:wrap;
  margin-bottom:clamp(16px,2vw,24px)}
.axes .axt{font-family:'Inter',sans-serif;font-weight:700;letter-spacing:-.02em;font-size:clamp(1rem,1.4vw,1.18rem)}
.axes .axs{font-family:'IBM Plex Mono',monospace;font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;color:var(--grey)}
.axes .axscroll{overflow-x:auto;scrollbar-width:thin;-webkit-overflow-scrolling:touch}
.axes svg{width:100%;height:auto;display:block;overflow:visible}
.axhint{display:none;font-family:'IBM Plex Mono',monospace;font-size:.62rem;letter-spacing:.12em;
  text-transform:uppercase;color:var(--grey2);margin-top:14px}
.ax-line{fill:none;stroke:var(--ink);stroke-width:1.7;stroke-linecap:round;
  stroke-dasharray:var(--len);stroke-dashoffset:var(--len);transition:stroke-dashoffset 1.5s var(--ease2)}
.axes.in .ax-line{stroke-dashoffset:0}
.ax-cross{fill:none;stroke:var(--grey2);stroke-width:1.2;stroke-dasharray:3 6;opacity:0;
  transition:opacity .9s var(--ease) .55s}
.axes.in .ax-cross{opacity:1}
.ax-node{fill:#fff;stroke:var(--ink);stroke-width:1.7;opacity:0;transition:opacity .5s var(--ease)}
.ax-node.hub{fill:var(--orange);stroke:var(--orange)}
.ax-halo{fill:rgba(255,111,32,.18);opacity:0;transform-box:fill-box;transform-origin:center}
.axes.in .ax-node{opacity:1}
.axes.in .ax-halo{opacity:1;animation:axring 3.2s var(--ease) infinite}
@keyframes axring{0%{transform:scale(.5);opacity:.9}70%,100%{transform:scale(2.2);opacity:0}}
/* Stadtnamen liegen ueber den gestrichelten Nord-Sued-Linien: weisse Kontur als Freistellung */
.ax-city{font-family:'Inter',sans-serif;font-weight:500;font-size:13px;fill:var(--ink);opacity:0;
  paint-order:stroke fill;stroke:#fff;stroke-width:4px;stroke-linejoin:round;
  transition:opacity .6s var(--ease)}
.axes.in .ax-city{opacity:1}
.ax-city.hub{font-weight:700}
.ax-tag{font-family:'IBM Plex Mono',monospace;font-size:13px;fill:var(--orange);letter-spacing:.04em;
  paint-order:stroke fill;stroke:#fff;stroke-width:4px;stroke-linejoin:round}
.ax-tag.sec{fill:var(--grey2);font-size:11.5px}
@media(prefers-reduced-motion:reduce){
 .ax-line{stroke-dashoffset:0!important;transition:none}
 .ax-cross,.ax-node,.ax-city{opacity:1!important;transition:none}
 .axes.in .ax-halo{animation:none;opacity:.4}
}
.loc-points{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(22px,2.8vw,44px);
  border-top:1px solid var(--line);margin-top:clamp(34px,4vw,54px);padding-top:clamp(26px,3vw,38px)}
.loc-pt h4{font-size:1.02rem;font-weight:600;letter-spacing:-.01em;display:flex;align-items:center;gap:12px}
.loc-pt h4::before{content:"";width:9px;height:9px;background:var(--orange);flex:0 0 auto;border-radius:2px}
.loc-pt p{color:var(--grey);font-size:.93rem;line-height:1.65;margin-top:9px;padding-left:21px}
.loc-foot{margin-top:clamp(32px,4vw,52px);display:flex;align-items:flex-end;justify-content:space-between;
  gap:24px 44px;flex-wrap:wrap}
.loc-claim{font-size:clamp(1.18rem,2vw,1.62rem);font-weight:500;letter-spacing:-.02em;line-height:1.34;max-width:26ch}
.loc-claim em{font-style:normal;color:var(--orange)}
.loc-foot .acts{display:flex;gap:12px;flex-wrap:wrap}
@media(max-width:980px){.loc-points{grid-template-columns:1fr 1fr}}
@media(max-width:820px){.axes .axscroll svg{min-width:780px}.axhint{display:block}}
@media(max-width:600px){.loc-points{grid-template-columns:1fr;gap:26px}}

/* ===== VERMITTLUNGEN (Karussell) ===== */
.deals{background:var(--paper);padding:clamp(90px,12vw,150px) 0 clamp(80px,10vw,130px)}
.deals-head{display:flex;justify-content:space-between;align-items:flex-end;gap:28px;flex-wrap:wrap;margin-bottom:clamp(28px,3.6vw,44px)}
.deals-head .live{display:inline-flex;align-items:center;gap:12px;font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:clamp(.92rem,1.15vw,1.12rem);letter-spacing:.22em;text-transform:uppercase;color:var(--orange)}
.deals-head .live .ping{position:relative;width:9px;height:9px;border-radius:50%;background:var(--orange);flex:0 0 auto}
.deals-head .live .ping::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--orange);animation:ping 1.8s var(--ease) infinite}
@keyframes ping{0%{transform:scale(1);opacity:.7}80%,100%{transform:scale(2.8);opacity:0}}
@media(prefers-reduced-motion:reduce){.deals-head .live .ping::after{animation:none;opacity:0}}
.deals-head h2{font-family:'Benton Wide';font-weight:900;text-transform:uppercase;line-height:.95;font-size:clamp(1.8rem,3.6vw,2.9rem);margin-top:clamp(16px,1.8vw,26px);max-width:16ch}
.deals-head p{color:var(--grey);max-width:44ch;font-size:1rem;line-height:1.7;margin-top:16px}
.deals-marquee{margin-top:clamp(26px,3.2vw,42px);width:100vw;position:relative;left:50%;transform:translateX(-50%);overflow:hidden;cursor:grab;touch-action:pan-y}
.deals-marquee.grabbing,.deals-marquee.grabbing .ocard{cursor:grabbing}
.deals-track{display:flex;gap:clamp(16px,1.6vw,22px);width:max-content;padding-inline:clamp(11px,.8vw,16px);will-change:transform;user-select:none;-webkit-user-select:none}
.deals-marquee.dragx{overflow-x:auto;scrollbar-width:none}
.deals-marquee.dragx::-webkit-scrollbar{display:none}
.ocard{position:relative;flex:0 0 clamp(272px,28vw,344px);height:clamp(356px,36vw,428px);border-radius:16px;overflow:hidden;background:var(--bone2);scroll-snap-align:start;isolation:isolate;cursor:pointer}
.ocard .ph{position:absolute;inset:0;z-index:-2}
.ocard .ph img{width:100%;height:100%;object-fit:cover;transition:transform 1s var(--ease)}
.ocard:hover .ph img{transform:scale(1.06)}
.ocard::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(14,12,11,.1) 0%,rgba(14,12,11,.14) 34%,rgba(14,12,11,.9) 100%)}
.ocard .idx{position:absolute;top:15px;left:17px;font-family:'IBM Plex Mono';font-size:.62rem;letter-spacing:.13em;color:#fff;opacity:.92;display:inline-flex;align-items:center;gap:8px;text-transform:uppercase}
.ocard .idx i{width:6px;height:6px;border-radius:50%;background:var(--orange);display:inline-block}
.ocard .size{position:absolute;top:13px;right:13px;background:var(--orange);color:#fff;font-weight:600;font-size:.74rem;padding:7px 12px;border-radius:100px}
.ocard .info{position:absolute;left:18px;right:18px;bottom:17px;color:#fff}
.ocard .info .city{font-family:'Inter';font-weight:700;letter-spacing:-.02em;font-size:clamp(1.2rem,1.7vw,1.5rem);line-height:1.05;color:#fff}
.ocard .info .city span{display:block;font-size:.72em;font-weight:500;color:rgba(255,255,255,.82);margin-top:5px;line-height:1.2}
.ocard .info .city::after{content:"";display:block;width:26px;height:2px;background:var(--orange);margin-top:9px}
.ocard .info .parties{margin-top:12px;display:flex;flex-direction:column;gap:5px}
.ocard .info .parties span{display:flex;gap:8px;font-size:.79rem;line-height:1.35;color:rgba(255,255,255,.88)}
.ocard .info .parties b{font-family:'IBM Plex Mono';font-weight:400;font-size:.64rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.5);flex:0 0 62px;padding-top:2px}
.ocard .info .open{margin-top:13px;display:inline-flex;align-items:center;gap:8px;font-family:'IBM Plex Mono';font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;opacity:0;transform:translateY(6px);transition:.4s var(--ease)}
.ocard:hover .info .open{opacity:1;transform:none}
.ocard[aria-hidden="true"]{pointer-events:auto}
@media(prefers-reduced-motion:reduce){.deals-track{animation:none!important}}
.deals-foot{margin-top:clamp(30px,3.6vw,46px);display:flex;align-items:center;justify-content:space-between;gap:20px 40px;flex-wrap:wrap}
.deals-foot p{color:var(--grey);font-size:.94rem;max-width:52ch}

/* ===== RESEARCH-TEASER =====
   Bewusst schmales Band statt eigenem Grossmodul: hier endet die Leistungsseite,
   die Zahlen und Marktberichte leben im Research-Bereich. */
.rsb{background:var(--bone);padding:clamp(66px,8.5vw,104px) 0}
