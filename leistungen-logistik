@media(max-width:440px){.rsb .acts{width:100%}.rsb .acts .btn{flex:1 1 100%;justify-content:center}}

/* ===== KONTAKT / ANSPRECHPARTNER ===== */
.cta{background:var(--bg);color:#fff;padding:clamp(90px,12vw,150px) 0 clamp(60px,7vw,90px);position:relative;overflow:hidden;border-top:1px solid var(--line-d)}
.cta .glow{position:absolute;inset:0;pointer-events:none;z-index:0;background:radial-gradient(620px circle at var(--gx,60%) var(--gy,40%),rgba(255,111,32,.16),transparent 68%)}
