/* ===== FLAECHENARTEN =====
   Liste links steuert die Textflaeche rechts. Verknuepfung ueber data-a,
   damit Reihenfolge und Anzahl im Markup frei bleiben. Tastatur: Pfeiltasten. */
(function(){
 const items=[...document.querySelectorAll('.art-item')];
 const bodies=[...document.querySelectorAll('.art-body')];
 if(!items.length)return;
 function show(key){
  items.forEach(i=>{const on=i.dataset.a===key;i.classList.toggle('on',on);i.setAttribute('aria-selected',on);});
  bodies.forEach(b=>{const on=b.dataset.a===key;b.classList.toggle('on',on);b.setAttribute('aria-hidden',!on);});
 }
 items.forEach((it,i)=>{
  it.addEventListener('click',()=>show(it.dataset.a));
  it.addEventListener('keydown',e=>{
   if(e.key!=='ArrowDown'&&e.key!=='ArrowUp')return;
   e.preventDefault();
   const n=items[(i+(e.key==='ArrowDown'?1:items.length-1))%items.length];
   n.focus();show(n.dataset.a);
  });
 });
 show(items[0].dataset.a);
})();

/* ===== ACHSENDIAGRAMM =====
   Linien zeichnen sich beim Eintritt ins Bild, Staedte blenden von West nach Ost nach. */
(function(){
 const fig=document.getElementById('axes');
 if(!fig)return;
 fig.querySelectorAll('.ax-line').forEach(l=>l.style.setProperty('--len',l.getTotalLength()));
 const nodes=[...fig.querySelectorAll('.ax-node,.ax-city')]
   .map(el=>({el,x:parseFloat(el.getAttribute('cx')||el.getAttribute('x')||0)}))
   .sort((a,b)=>a.x-b.x);
 nodes.forEach((n,i)=>{n.el.style.transitionDelay=(.5+i*.045)+'s';});
 new IntersectionObserver((es,ob)=>es.forEach(e=>{
  if(e.isIntersecting){fig.classList.add('in');ob.disconnect();}
 }),{threshold:.25}).observe(fig);
})();

