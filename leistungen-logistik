/* ===== MERKLISTE (global, Nav-Lesezeichen) ===== */
(function(){
 const KEY='cubion_merkliste';
 const nav=document.getElementById('merkNav'),badge=document.getElementById('merkBadge');
 if(!nav||!badge)return;
 const read=()=>{try{const a=JSON.parse(localStorage.getItem(KEY)||'[]');return Array.isArray(a)?a:[];}catch(e){return[];}};
 const write=a=>localStorage.setItem(KEY,JSON.stringify(a));
 let count=read().length;
 function render(bump){
  const n=read().length;
  badge.textContent=n;
  if(n===0){badge.setAttribute('hidden','');}else{badge.removeAttribute('hidden');}
  nav.classList.toggle('filled',n>0);
  if(bump&&n>count){nav.classList.remove('bump');void nav.offsetWidth;nav.classList.add('bump');}
  count=n;
 }
 window.Merkliste={
  list:read,
  has:id=>read().includes(id),
  count:()=>read().length,
  add(id){const a=read();if(!a.includes(id)){a.push(id);write(a);render(true);}return true;},
  remove(id){write(read().filter(x=>x!==id));render(false);},
  toggle(id){return this.has(id)?(this.remove(id),false):(this.add(id),true);}
 };
 addEventListener('storage',e=>{if(e.key===KEY)render(true);});
 render(false);
})();

