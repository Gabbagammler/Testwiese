 document.getElementById('topItem').classList.toggle('show',scrollY>innerHeight*0.8);
 railEl.classList.toggle('show',scrollY>innerHeight*0.55);
}
let ticking=false;
addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(()=>{onScroll();ticking=false;});ticking=true;}},{passive:true});
addEventListener('resize',onScroll);
addEventListener('load',onScroll);
onScroll();

/* ===== magnetic buttons ===== */
if(!reduce&&matchMedia('(pointer:fine)').matches){
 document.querySelectorAll('.magnet').forEach(el=>{
   el.addEventListener('mousemove',e=>{const r=el.getBoundingClientRect();el.style.transform='translate('+((e.clientX-r.left-r.width/2)*.3)+'px,'+((e.clientY-r.top-r.height/2)*.3)+'px)';});
   el.addEventListener('mouseleave',()=>el.style.transform='');
 });
}

/* ===== CTA CURSOR GLOW ===== */
const ctaSec=document.getElementById('kontakt');
if(ctaSec&&matchMedia('(pointer:fine)').matches){
 ctaSec.addEventListener('pointermove',e=>{
  const r=ctaSec.getBoundingClientRect();
  ctaSec.style.setProperty('--gx',(e.clientX-r.left)+'px');
  ctaSec.style.setProperty('--gy',(e.clientY-r.top)+'px');
 });
}
</script>
