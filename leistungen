const C={Büro:'#14110F',Logistik:'var(--steel-gray)'};
const DEALS=[
  {c:'Büro',t:'Essen: rd. 270 m² an ZENZ Patentanwälte',img:'2026/06/CUBION-Deal-Huyssenallee-15-768x551.jpg'},
