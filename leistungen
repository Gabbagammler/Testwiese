  {c:'Büro',t:'Dortmund: 670 m² am Sebrathweg 1–9',img:'2026/04/Dortmund-CUBION-vermittelt-670-m%C2%B2-Bueroflaeche-am-Sebrathweg-1%E2%80%939-768x432.jpg'},
  {c:'Büro',t:'Duisburg: rd. 1.300 m² Businesspark Asterlagen',img:'2026/03/Dr.-Alfred-Herrhausen-Allee-9-11-Deal-CUBION-web-768x432.jpg'},
  {c:'Büro',t:'Duisburg: rd. 735 m² am Innenhafen an HOLINGER',img:'2026/01/CUBION-Deal-Schifferstrasse-166-1-768x432.jpg'},
  {c:'Büro',t:'Essen: rd. 345 m² EUROPA-CENTER Trineo an UKA',img:'2026/01/Am-Europa-Center-4-in-Essen-Deal-CUBION-768x576.jpg'},
  {c:'Logistik',t:'Duisburg: rd. 10.000 m² Freilager an CONDACO',img:'2025/10/CUBION-vermittelte-rund-10.000-m%C2%B2-Freilagerflaeche-in-Duisburg-an-CONDACO.-Der-Spezialist-fuer-Containerloesungen-erweitert-damit-seine-Lager-und-Logistikflaechen-768x512.jpg'},
  {c:'Logistik',t:'Düsseldorf: 2.400 m² an The Padel Company',img:'2025/09/Duesseldorf-CUBION-vermittelt-2.400-m%C2%B2-an-The-Padel-Company-im-SEGRO-Park-Flingern-768x513.jpg'},
  {c:'Logistik',t:'Isselburg: 25.000 m² Freilager an Rudolph Logistik',img:'2025/03/CUBION-Deal-Isselburg-Freilagerflaeche_web-768x432.jpg'},
  {c:'Logistik',t:'Gelsenkirchen: rd. 30.000 m² Logistik an FineCom',img:'CUBION-30.000-qm-Deal_-scaled.jpg'},
  {c:'Logistik',t:'Essen: rd. 2.000 m² Halle an Element Boulders',img:'CUBION-Deal-Haedenkampstrasse-73-Essen-scaled.jpg'},
  {c:'Büro',t:'Gelsenkirchen: 2.100 m² Büro- und Hallenfläche',img:'2026/01/Hamburger-Strasse-11-Deal-CUBION-768x432.jpg'}
];
document.getElementById('dealRow').innerHTML=[...DEALS,...DEALS].map(d=>
  `<article class="deal"><div class="ph"><span class="cat" style="background:${C[d.c]}">${d.c==='Logistik'?'Logistics':'Büro'}</span><img src="${B}${d.img}" alt="${d.t}" loading="lazy"></div><div class="meta">${d.t}</div></article>`).join('');

/* Reveal */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
</script>
