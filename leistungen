<script>
/* Nav + mobile */
const nav=document.getElementById('nav');
addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>40),{passive:true});
const burger=document.getElementById('burger'),menu=document.getElementById('mobileMenu');
burger.addEventListener('click',()=>{const o=menu.classList.toggle('open');burger.setAttribute('aria-label',o?'Menü schließen':'Menü öffnen')});
menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>menu.classList.remove('open')));

/* ---------- DATEN ---------- */
const SERVICES={
  mieter:{
    lead:'Sie suchen Fläche. Wir vertreten <b>ausschließlich Ihre Interessen</b> – von der Strategie bis zum Einzug.',
    items:['Marktanalysen','Immobilienstrategie & Anforderungsprofil','Passende Objekte lokalisieren & anbieten','Begleitung & Beratung bei Besichtigungen','Technische & kaufmännische Erstberatung','Unterstützung bei Mietpreisverhandlungen','Bauunternehmer, Architekten & Statiker vermitteln','Untervermietung Ihrer Bestandsimmobilie','Tenant Representation','Mietvertragsprüfung','Workplace-Beratung mit Partnerunternehmen']
  },
  vermieter:{
    lead:'Sie haben Fläche. Wir bringen sie <b>an den Markt</b> – mit Research, Vermarktung und den richtigen Mietern.',
    items:['Marktresearch','Mietpreiseinschätzung','Strategieberatung für Ihre Immobilie','Wettbewerbsanalyse & -vergleich','Drohnenaufnahmen Ihres Objekts','Professionelle & innovative Vermarktungskonzepte','Platzierung in Portalen & bei Suchkunden','Ermittlung & Selektion passender Interessenten','Bonitätsabfrage der Interessenten','Durchführung von Besichtigungen','Begleitung der Mietvertragsverhandlungen','Koordination von Drittmaklern','Bauunternehmer, Architekten & Statiker vermitteln']
  }
};
const PROCESS={
  mieter:[
    ['Anforderungsprofil','Bedarf, Budget und Standortkriterien gemeinsam schärfen.'],
    ['Marktanalyse & Auswahl','Passende Objekte recherchieren, sichten und kuratieren.'],
    ['Besichtigung & Beratung','Vor Ort begleiten, technisch und kaufmännisch einordnen.'],
    ['Verhandlung','Mietpreis und Konditionen in Ihrem Sinne verhandeln.'],
    ['Vertrag & Einzug','Mietvertrag prüfen, Übergabe und Start begleiten.']
  ],
  vermieter:[
    ['Research & Preis','Marktresearch und realistische Mietpreiseinschätzung.'],
    ['Vermarktungskonzept','Strategie, Drohnenaufnahmen und Materialien erstellen.'],
    ['Platzierung','In Portalen und bei aktiven Suchkunden positionieren.'],
    ['Auswahl & Bonität','Interessenten selektieren, Bonität prüfen, besichtigen.'],
    ['Abschluss','Vertragsverhandlung begleiten bis zur Unterschrift.']
  ]
};
const CHECK='<svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

let mode='mieter';
const svcGrid=document.getElementById('svcGrid');
const svcLead=document.getElementById('svcLead');
const svcPanel=document.getElementById('svcPanel');
const stepsEl=document.getElementById('steps');
const procWho=document.getElementById('procWho');

function renderServices(){
  const s=SERVICES[mode];
  svcLead.innerHTML=s.lead;
  svcGrid.innerHTML=s.items.map(t=>`<div class="svc-item"><span class="mk">${CHECK}</span><span class="tx">${t}</span></div>`).join('');
}
function renderProcess(){
  stepsEl.innerHTML=PROCESS[mode].map((s,i)=>`<div class="pstep"><div class="dot">0${i+1}</div><h3>${s[0]}</h3><p>${s[1]}</p></div>`).join('');
  procWho.textContent=mode==='mieter'?'als Mieter':'als Vermieter';
}
function swap(){
  svcPanel.classList.add('swap');stepsEl.classList.add('swap');
  setTimeout(()=>{renderServices();renderProcess();svcPanel.classList.remove('swap');stepsEl.classList.remove('swap');},340);
}
renderServices();renderProcess();

/* Audience toggle + sliding pill */
const aud=document.getElementById('aud');
const pill=document.getElementById('pill');
const audBtns=[...aud.querySelectorAll('button')];
function movePill(){
  const active=aud.querySelector('button.active');
  pill.style.width=active.offsetWidth+'px';
  pill.style.transform='translateX('+(active.offsetLeft-6)+'px)';
}
audBtns.forEach(b=>b.addEventListener('click',()=>{
  if(b.classList.contains('active'))return;
  audBtns.forEach(x=>x.classList.remove('active'));b.classList.add('active');
  mode=b.dataset.mode;movePill();swap();
}));
addEventListener('load',movePill);addEventListener('resize',movePill);movePill();

/* ---------- FLÄCHENRECHNER ---------- */
const AREA_WS=9, COMMUNAL=0.35;
const emp=document.getElementById('emp'),rate=document.getElementById('rate');
const empVal=document.getElementById('empVal'),rateVal=document.getElementById('rateVal');
const areaEl=document.getElementById('area'),wsLine=document.getElementById('wsLine');
const costM=document.getElementById('costM'),costY=document.getElementById('costY'),saveEl=document.getElementById('save');
let factor=0.7;
const nf=n=>Math.round(n).toLocaleString('de-DE');
const eur=n=>Math.round(n).toLocaleString('de-DE')+' €';
function area(e,f){const ws=Math.ceil(e*f);const base=ws*AREA_WS;const total=Math.round(base*(1+COMMUNAL)/5)*5;return{ws,total}}
function compute(){
  const e=+emp.value, r=+rate.value;
  const {ws,total}=area(e,factor);
  empVal.textContent=e;
  rateVal.textContent=r.toLocaleString('de-DE',{minimumFractionDigits:2,maximumFractionDigits:2})+' €/m²';
  areaEl.textContent=nf(total);
  wsLine.textContent='≈ '+nf(ws)+' Arbeitsplätze · '+nf(e)+' Mitarbeitende';
  costM.textContent=eur(total*r);
  costY.textContent=eur(total*r*12);
  const pres=area(e,1).total;
  const savM2=pres-total;
  if(savM2>0){
    saveEl.style.display='block';
    saveEl.innerHTML='Einsparpotenzial ggü. reiner Präsenz: <b>~'+nf(savM2)+' m²</b> · rund <b>'+eur(savM2*r*12)+'/Jahr</b>';
  } else saveEl.style.display='none';
}
emp.addEventListener('input',compute);
rate.addEventListener('input',compute);
document.querySelectorAll('.mode').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('.mode').forEach(x=>x.classList.remove('active'));
  b.classList.add('active');factor=+b.dataset.f;compute();
}));
compute();

/* ---------- DEALS MARQUEE ---------- */
