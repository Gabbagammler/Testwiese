const order=['duisburg','essen','dortmund','bochum'];
const card=document.querySelector('.ex-card');
const tabsEl=document.getElementById('tabs');
const zonesEl=document.getElementById('zones');
const panelEl=document.getElementById('panel');
let curCity='essen',curZone=0;
const eur=v=>v.toLocaleString('de-DE',{minimumFractionDigits:2,maximumFractionDigits:2})+' €';

function renderTabs(){
  tabsEl.innerHTML=order.map(c=>`<button class="tab ${c===curCity?'active':''}" data-city="${c}" style="--uc:${RENT[c].accent}">${RENT[c].label}</button>`).join('');
  tabsEl.querySelectorAll('.tab').forEach(b=>{
    b.addEventListener('click',()=>{curCity=b.dataset.city;curZone=0;renderAll()});
  });
}
function renderZones(){
  const zs=RENT[curCity].zones;
  zonesEl.innerHTML=zs.map((z,i)=>{
    const top=topRent(z.t);
    return `<button class="zone ${i===curZone?'active':''}" data-i="${i}"><span>${z.z}</span><span class="ind">${top?eur(top):'—'}</span></button>`;
  }).join('');
  zonesEl.querySelectorAll('.zone').forEach(b=>b.addEventListener('click',()=>{curZone=+b.dataset.i;renderZones();renderPanel()}));
}
function topRent(t){let m=0;t.forEach(r=>{if(r)m=Math.max(m,r[1])});return m||null}
function renderPanel(){
  const z=RENT[curCity].zones[curZone];
  const top=topRent(z.t);
  let rows=TIERS.map((tier,i)=>{
    const r=z.t[i];
    if(!r) return `<div class="tier"><div><div class="tname">${tier.n}</div><div class="tdesc">${tier.d}</div></div><div class="track"></div><div class="price na">nicht verfügbar</div></div>`;
    const left=(r[0]/SCALE*100).toFixed(1), w=Math.max((r[1]-r[0])/SCALE*100,1.5).toFixed(1);
    return `<div class="tier"><div><div class="tname">${tier.n}</div><div class="tdesc">${tier.d}</div></div>`+
      `<div class="track"><span class="seg t${i}" style="left:${left}%;width:${w}%"></span></div>`+
      `<div class="price">${eur(r[0])} – ${eur(r[1])}</div></div>`;
  }).join('');
  panelEl.innerHTML=
    `<div class="panel-head"><div><div class="ztag"><span class="sq"></span>${RENT[curCity].label}</div><h3>${z.z}</h3></div>`+
    `<div class="top"><div class="v">${top?eur(top).replace(' €',''):'—'}</div><div class="k">Spitzenmiete €/m²</div></div></div>`+
    rows+
    `<div class="ruler"><div class="marks"><span>0</span><span>8</span><span>16</span><span>24</span><span>32 €</span></div></div>`;
}
function renderAll(){card.style.setProperty('--accent',RENT[curCity].accent);renderTabs();renderZones();renderPanel()}
renderAll();

/* quick links jump to city */
document.querySelectorAll('.quick .cities a[data-city]').forEach(a=>{
  a.addEventListener('click',()=>{curCity=a.dataset.city;curZone=0;renderAll()});
});

/* Reveal */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

/* Count-up (de-DE) */
function animateCount(el){
  const end=parseFloat(el.dataset.count),dec=parseInt(el.dataset.decimals||'0'),unit=el.dataset.unit||'';
  const dur=1500;let t0=null;
  const fmt=v=>v.toLocaleString('de-DE',{minimumFractionDigits:dec,maximumFractionDigits:dec});
  const step=ts=>{if(!t0)t0=ts;const p=Math.min((ts-t0)/dur,1);const e=1-Math.pow(1-p,3);
    el.innerHTML=fmt(end*e)+(unit?'<span class="u">'+unit+'</span>':'');
    if(p<1)requestAnimationFrame(step)};
  requestAnimationFrame(step);
}
const co=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){animateCount(e.target.querySelector('.num'));co.unobserve(e.target)}}),{threshold:.5});
document.querySelectorAll('.stat,.pop').forEach(s=>co.observe(s));
</script>
